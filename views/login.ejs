<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login · TeleAuto</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      background: #ebedef;
    }

    /* ── Left brand panel ── */
    .panel-brand {
      width: 420px;
      background: linear-gradient(160deg, #0b0e1a 0%, #111827 100%);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3rem 2.5rem;
      flex-shrink: 0;
    }
    .panel-brand::before {
      content:'';
      position:absolute;
      top:-120px; right:-80px;
      width:380px; height:380px;
      border-radius:50%;
      background:radial-gradient(circle,rgba(99,102,241,.25) 0%,transparent 70%);
    }
    .panel-brand::after {
      content:'';
      position:absolute;
      bottom:-100px; left:-60px;
      width:320px; height:320px;
      border-radius:50%;
      background:radial-gradient(circle,rgba(139,92,246,.18) 0%,transparent 70%);
    }
    .brand-content { position:relative; z-index:1; text-align:center; max-width:320px; }

    .brand-logo {
      width:80px; height:80px;
      background:linear-gradient(135deg,#6366f1,#8b5cf6);
      border-radius:22px;
      display:inline-flex;
      align-items:center; justify-content:center;
      font-size:2.25rem; color:#fff;
      margin-bottom:1.5rem;
      box-shadow: 0 8px 32px rgba(99,102,241,.4), 0 0 0 1px rgba(99,102,241,.2);
    }
    .brand-name {
      font-size:2.5rem; font-weight:800; color:#fff;
      letter-spacing:-0.5px; margin-bottom:.4rem;
    }
    .brand-name em {
      font-style:normal;
      background:linear-gradient(135deg,#a5b4fc,#c084fc);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent;
      background-clip:text;
    }
    .brand-ver {
      display:inline-block; font-size:.75rem; font-weight:600;
      color:#6366f1; background:rgba(99,102,241,.12);
      border:1px solid rgba(99,102,241,.25);
      padding:3px 10px; border-radius:20px; margin-bottom:1.25rem;
    }
    .brand-tagline {
      color:#94a3b8; font-size:.9rem; line-height:1.7; margin-bottom:2.5rem;
    }
    .brand-feats { display:flex; flex-direction:column; gap:.875rem; width:100%; }
    .feat {
      display:flex; align-items:center; gap:12px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.07);
      border-radius:10px; padding:.75rem 1rem; text-align:left;
    }
    .feat-ic {
      width:34px; height:34px; flex-shrink:0;
      background:rgba(99,102,241,.15);
      border:1px solid rgba(99,102,241,.3);
      border-radius:8px; display:flex;
      align-items:center; justify-content:center;
      color:#818cf8; font-size:.875rem;
    }
    .feat span { font-size:.8125rem; color:#cbd5e1; font-weight:500; }

    /* ── Right login panel ── */
    .panel-login {
      flex:1; display:flex;
      align-items:center; justify-content:center;
      padding:2rem;
    }
    .login-card {
      background:#fff; border-radius:20px;
      padding:3rem 2.5rem; width:100%; max-width:440px;
      box-shadow:0 4px 24px rgba(0,0,21,.08),0 1px 4px rgba(0,0,21,.06);
    }
    .login-hello { margin-bottom:2rem; }
    .login-hello h2 {
      font-size:1.75rem; font-weight:700; color:#0f172a;
      margin-bottom:.375rem; letter-spacing:-0.3px;
    }
    .login-hello p { color:#64748b; font-size:.9rem; }

    .fg { margin-bottom:1.375rem; }
    .fl { display:block; font-size:.8375rem; font-weight:600; color:#374151; margin-bottom:.5rem; }

    .iw { position:relative; }
    .ii {
      position:absolute; left:13px; top:50%; transform:translateY(-50%);
      color:#9ca3af; font-size:.875rem; pointer-events:none;
    }
    .fi {
      width:100%; padding:12px 42px;
      border:1.5px solid #e5e7eb; border-radius:10px;
      font-size:.9375rem; font-family:'Inter',sans-serif;
      color:#0f172a; background:#fafafa; transition:all .2s;
    }
    .fi:focus {
      outline:none; border-color:#6366f1; background:#fff;
      box-shadow:0 0 0 3px rgba(99,102,241,.12);
    }
    .fi::placeholder { color:#c0c4ce; font-weight:400; }
    .tpwd {
      position:absolute; right:11px; top:50%; transform:translateY(-50%);
      background:none; border:none; cursor:pointer;
      color:#9ca3af; padding:5px; border-radius:6px; transition:color .15s;
    }
    .tpwd:hover { color:#6366f1; }

    #alertBox { margin-bottom:1rem; }
    .aerr {
      background:#fef2f2; color:#b91c1c;
      border:1px solid #fecaca; border-radius:8px;
      padding:11px 14px; font-size:.875rem;
      display:flex; align-items:center; gap:8px;
    }
    .btn-login {
      width:100%; padding:13px;
      background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 100%);
      color:#fff; border:none; border-radius:10px;
      font-size:.9375rem; font-weight:600; font-family:'Inter',sans-serif;
      cursor:pointer; letter-spacing:.2px; transition:all .2s;
      box-shadow:0 4px 14px rgba(99,102,241,.35);
      display:flex; align-items:center; justify-content:center; gap:8px;
    }
    .btn-login:hover { transform:translateY(-1px); box-shadow:0 6px 20px rgba(99,102,241,.45); }
    .btn-login:active { transform:translateY(0); }
    .btn-login:disabled { opacity:.7; cursor:not-allowed; transform:none; }

    .lfoot {
      margin-top:2rem; text-align:center;
      border-top:1px solid #f1f5f9; padding-top:1.5rem;
    }
    .lfoot p { color:#9ca3af; font-size:.8rem; }
    .lfoot i.fa-heart { color:#ef4444; }
    .secure { display:inline-flex;align-items:center;gap:5px;color:#10b981;font-size:.8rem;margin-top:.5rem; }

    @media (max-width:900px) { .panel-brand { width:360px; } }
    @media (max-width:768px) {
      body { flex-direction:column; }
      .panel-brand { width:100%; padding:2.5rem 1.5rem 2rem; }
      .brand-feats { display:none; }
      .brand-name { font-size:2rem; }
      .panel-login { padding:1.5rem; }
      .login-card { padding:2rem 1.5rem; max-width:100%; }
    }
    @media (max-width:420px) {
      .panel-brand { padding:2rem 1.25rem 1.75rem; }
      .login-card { padding:1.75rem 1.25rem; border-radius:16px; }
      .login-hello h2 { font-size:1.5rem; }
    }
    @keyframes shake {
      0%,100% { transform:translateX(0); }
      20%,60%  { transform:translateX(-5px); }
      40%,80%  { transform:translateX(5px); }
    }
    .shake { animation:shake .4s ease; }
  </style>
</head>
<body>
  <aside class="panel-brand">
    <div class="brand-content">
      <div class="brand-logo"><i class="fas fa-robot"></i></div>
      <h1 class="brand-name">Tele<em>Auto</em></h1>
      <span class="brand-ver">v5.0 Admin Panel</span>
      <p class="brand-tagline">Kelola halaman, pantau aktivitas, dan terima notifikasi secara real&#8209;time.</p>
      <div class="brand-feats">
        <div class="feat">
          <div class="feat-ic"><i class="fas fa-shield-halved"></i></div>
          <span>Sesi aman &amp; terenkripsi</span>
        </div>
        <div class="feat">
          <div class="feat-ic"><i class="fab fa-telegram"></i></div>
          <span>Notifikasi instan via Telegram</span>
        </div>
        <div class="feat">
          <div class="feat-ic"><i class="fas fa-chart-line"></i></div>
          <span>Statistik visitor real&#8209;time</span>
        </div>
      </div>
    </div>
  </aside>

  <main class="panel-login">
    <div class="login-card" id="lcard">
      <div class="login-hello">
        <h2>Selamat datang &#x1F44B;</h2>
        <p>Masukkan kredensial Anda untuk mengakses dashboard</p>
      </div>
      <form id="loginForm" novalidate>
        <div class="fg">
          <label class="fl" for="username">Username</label>
          <div class="iw">
            <i class="fas fa-user ii"></i>
            <input type="text" class="fi" id="username" name="username"
              placeholder="Masukkan username" autocomplete="username" required>
          </div>
        </div>
        <div class="fg">
          <label class="fl" for="password">Password</label>
          <div class="iw">
            <i class="fas fa-lock ii"></i>
            <input type="password" class="fi" id="password" name="password"
              placeholder="Masukkan password" autocomplete="current-password" required>
            <button type="button" id="tpwd" class="tpwd" aria-label="Toggle password">
              <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>
        <div id="alertBox"></div>
        <button type="submit" class="btn-login" id="loginBtn">
          <i class="fas fa-sign-in-alt"></i>
          Masuk ke Dashboard
        </button>
      </form>
      <div class="lfoot">
        <p>Made with <i class="fas fa-heart"></i> by RndyTech</p>
        <div class="secure"><i class="fas fa-lock"></i> Koneksi aman &amp; terenkripsi</div>
      </div>
    </div>
  </main>

  <script>
    const tpwd     = document.getElementById('tpwd');
    const pwdInput = document.getElementById('password');
    const eyeIcon  = document.getElementById('eyeIcon');
    const loginBtn = document.getElementById('loginBtn');
    const loginForm= document.getElementById('loginForm');
    const alertBox = document.getElementById('alertBox');
    const lcard    = document.getElementById('lcard');

    tpwd.addEventListener('click', () => {
      const show = pwdInput.type === 'password';
      pwdInput.type = show ? 'text' : 'password';
      eyeIcon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
    });

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';
      loginBtn.disabled = true;
      try {
        const res  = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: document.getElementById('username').value,
            password: pwdInput.value
          })
        });
        const data = await res.json();
        if (data.success) {
          loginBtn.innerHTML = '<i class="fas fa-check"></i> Login Berhasil!';
          loginBtn.style.background = 'linear-gradient(135deg,#10b981,#059669)';
          loginBtn.style.boxShadow  = '0 4px 14px rgba(16,185,129,.35)';
          setTimeout(() => window.location.href = data.redirect, 800);
        } else {
          showErr(data.message || 'Username atau password salah!');
          resetBtn();
        }
      } catch { showErr('Terjadi kesalahan koneksi. Coba lagi.'); resetBtn(); }
    });

    function showErr(msg) {
      alertBox.innerHTML = `<div class="aerr"><i class="fas fa-triangle-exclamation"></i>${msg}</div>`;
      lcard.classList.add('shake');
      setTimeout(() => lcard.classList.remove('shake'), 400);
      setTimeout(() => alertBox.innerHTML = '', 4500);
    }

    function resetBtn() {
      loginBtn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Masuk ke Dashboard';
      loginBtn.disabled  = false;
      loginBtn.style.background  = '';
      loginBtn.style.boxShadow   = '';
    }

    document.querySelectorAll('.fi').forEach(el => {
      el.addEventListener('focus', () => el.parentNode.style.transform = 'translateY(-1px)');
      el.addEventListener('blur',  () => el.parentNode.style.transform = '');
    });
  </script>
</body>
</html>
