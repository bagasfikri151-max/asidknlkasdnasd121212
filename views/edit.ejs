<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Website - TeleAuto V4.0</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; }
    body { background: #ebedef; color: #1a202c; min-height: 100vh; }

    /* Sidebar */
    .sidebar {
      position: fixed; left: 0; top: 0; width: 280px; height: 100vh;
      background: linear-gradient(160deg, #0b0e1a 0%, #1b2033 100%);
      color: white; z-index: 1000; transition: transform .3s ease; overflow-y: auto;
    }
    .sidebar-header { padding: 2rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); }
    .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 1rem; }
    .logo-icon {
      width: 45px; height: 45px; background: linear-gradient(135deg,#6366f1,#8b5cf6);
      border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
    }
    .logo-text {
      font-size: 1.5rem; font-weight: 800;
      background: linear-gradient(135deg,#a5b4fc,#c084fc);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .user-info { background: rgba(255,255,255,.1); padding: 1rem; border-radius: 12px; display: flex; align-items: center; gap: 12px; }
    .user-avatar { width: 40px; height: 40px; background: linear-gradient(135deg,#10b981,#059669); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; }
    .user-details h3 { font-size: .9rem; margin-bottom: 2px; }
    .user-details p { font-size: .75rem; color: #94a3b8; }
    .nav-menu { padding: 1.5rem 0; }
    .nav-section { margin-bottom: 2rem; }
    .nav-section-title { padding: 0 1.5rem; font-size: .75rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: .5px; margin-bottom: .5rem; }
    .nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 1.5rem; color: #e2e8f0; text-decoration: none; transition: all .2s; position: relative; }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,.1); color: white; }
    .nav-item.active::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: linear-gradient(135deg,#6366f1,#8b5cf6); }
    .nav-icon { width: 20px; text-align: center; }

    /* Main */
    .main-content { margin-left: 280px; min-height: 100vh; }

    /* Header */
    .header {
      background: white; padding: 1.25rem 2rem; border-bottom: 1px solid #e2e8f0;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 3px rgba(0,0,0,.08);
    }
    .header-left { display: flex; align-items: center; gap: 1rem; }
    .header-left h1 { font-size: 1.5rem; font-weight: 700; color: #1a202c; }
    .breadcrumb { font-size: .8rem; color: #64748b; margin-top: 2px; }
    .breadcrumb a { color: #6366f1; text-decoration: none; }
    .header-right { display: flex; gap: .75rem; }
    .mobile-menu-btn { display: none; background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #1a202c; padding: 6px; border-radius: 8px; transition: background .2s; }
    .mobile-menu-btn:hover { background: #f1f5f9; }

    /* Buttons */
    .btn { padding: 9px 18px; border: none; border-radius: 9px; font-size: .875rem; font-weight: 500; cursor: pointer; transition: all .2s; text-decoration: none; display: inline-flex; align-items: center; gap: 7px; font-family: inherit; }
    .btn-primary { background: linear-gradient(135deg,#6366f1,#4f46e5); color: white; box-shadow: 0 2px 8px rgba(99,102,241,.3); }
    .btn-primary:hover { background: linear-gradient(135deg,#4f46e5,#4338ca); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(99,102,241,.4); }
    .btn-secondary { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .btn-secondary:hover { background: #e2e8f0; }
    .btn-danger { background: linear-gradient(135deg,#ef4444,#dc2626); color: white; font-size: .75rem; padding: 6px 10px; border-radius: 7px; }
    .btn-danger:hover { background: linear-gradient(135deg,#dc2626,#b91c1c); }
    .btn:disabled { opacity: .6; cursor: not-allowed; transform: none !important; }

    /* Page content */
    .page-content { padding: 2rem; max-width: 900px; }

    /* Banner */
    .edit-banner {
      background: linear-gradient(135deg,#6366f1,#4f46e5);
      border-radius: 16px; padding: 1.5rem 2rem; margin-bottom: 2rem;
      display: flex; align-items: center; gap: 1.25rem; color: white;
      box-shadow: 0 4px 20px rgba(99,102,241,.3);
    }
    .edit-banner-icon { width: 52px; height: 52px; background: rgba(255,255,255,.15); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
    .edit-banner h2 { font-size: 1.25rem; font-weight: 700; margin-bottom: 3px; }
    .edit-banner p { font-size: .875rem; opacity: .85; }

    /* Card */
    .card { background: white; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 1px 4px rgba(0,0,0,.07); margin-bottom: 1.5rem; overflow: hidden; }
    .card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 10px; }
    .card-header-icon { width: 34px; height: 34px; border-radius: 9px; background: rgba(99,102,241,.1); display: flex; align-items: center; justify-content: center; color: #6366f1; font-size: .9rem; }
    .card-header h3 { font-size: 1rem; font-weight: 600; color: #1a202c; }
    .card-body { padding: 1.5rem; }

    /* Form */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .form-group { display: flex; flex-direction: column; }
    .form-group.full { grid-column: 1 / -1; }
    .form-label { display: flex; align-items: center; gap: 7px; font-size: .8375rem; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .label-icon { color: #6366f1; font-size: .8rem; }
    .form-control { width: 100%; padding: 11px 14px; border: 1.5px solid #e5e7eb; border-radius: 10px; font-size: .9375rem; font-family: inherit; color: #0f172a; background: #fafafa; transition: all .18s; }
    .form-control:focus { outline: none; border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgba(99,102,241,.1); }
    .form-help { font-size: .75rem; color: #9ca3af; margin-top: 4px; }

    /* Current images */
    .img-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 12px; }
    .img-item { border: 1.5px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #f8fafc; transition: all .2s; }
    .img-item:hover { border-color: #6366f1; box-shadow: 0 2px 10px rgba(99,102,241,.15); }
    .img-item img { width: 100%; height: 90px; object-fit: cover; display: block; }
    .img-item-footer { padding: 6px; }
    .img-label { font-size: .7rem; font-weight: 600; color: #64748b; margin-bottom: 5px; }

    /* Upload slots */
    .upload-slots-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
    .upload-slot { border: 2px dashed #d1d5db; border-radius: 10px; padding: 1.25rem 1rem; text-align: center; cursor: pointer; transition: all .2s; background: #fafafa; }
    .upload-slot:hover { border-color: #6366f1; background: rgba(99,102,241,.04); }
    .upload-slot .slot-icon { font-size: 1.75rem; color: #d1d5db; margin-bottom: .5rem; transition: color .2s; }
    .upload-slot:hover .slot-icon { color: #6366f1; }
    .upload-slot .slot-text { font-size: .8rem; font-weight: 600; color: #374151; }
    .upload-slot .slot-hint { font-size: .73rem; color: #9ca3af; margin-top: 3px; }
    .upload-slot.has-file { border-color: #10b981; background: rgba(16,185,129,.04); }
    .upload-slot.has-file .slot-icon { color: #10b981; }
    .upload-slot .preview-thumb { width: 80px; height: 60px; object-fit: cover; border-radius: 6px; margin: 0 auto .5rem; display: block; border: 1.5px solid #e2e8f0; }

    /* Form actions */
    .form-actions { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; padding: 1.25rem 1.5rem; background: #f8fafc; border-top: 1px solid #f1f5f9; }

    /* Alert */
    .alert { padding: .875rem 1rem; border-radius: 10px; font-size: .875rem; display: flex; align-items: center; gap: 9px; margin-bottom: 1rem; }
    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .alert-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }

    /* Mobile */
    .sidebar-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,.5); z-index: 999; opacity: 0; visibility: hidden; transition: all .3s; }
    .sidebar-overlay.active { opacity: 1; visibility: visible; }
    @media (max-width: 768px) {
      .mobile-menu-btn { display: block; }
      .sidebar { transform: translateX(-100%); width: 100%; max-width: 300px; }
      .sidebar.mobile-open { transform: translateX(0); }
      .main-content { margin-left: 0; }
      .header { padding: 1rem; }
      .header-left h1 { font-size: 1.2rem; }
      .page-content { padding: 1rem; }
      .form-grid { grid-template-columns: 1fr; }
      .form-group.full { grid-column: auto; }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="logo">
        <div class="logo-icon"><i class="fas fa-robot"></i></div>
        <div class="logo-text">TeleAuto v5.0</div>
      </div>
      <%
        const safeName = (typeof usernm === 'string' ? usernm : '').trim();
        const initial = safeName ? safeName.charAt(0).toUpperCase() : 'A';
      %>
      <div class="user-info">
        <div class="user-avatar"><%= initial %></div>
        <div class="user-details">
          <h3><%= usernm %></h3>
          <p>Administrator</p>
        </div>
      </div>
    </div>
    <nav class="nav-menu">
      <div class="nav-section">
        <div class="nav-section-title">Menu Utama</div>
        <a href="/dash" class="nav-item"><i class="fas fa-home nav-icon"></i>Dashboard</a>
        <a href="/form" class="nav-item"><i class="fas fa-plus-circle nav-icon"></i>Tambah Website</a>
        <a href="https://t.me/<%= namebot %>" class="nav-item" target="_blank"><i class="fab fa-telegram nav-icon"></i>Bot Telegram</a>

     
      </div>
    </nav>
  </div>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>


  <div class="main-content">
    <header class="header">
      <div class="header-left">
        <button class="mobile-menu-btn" id="mobileMenuBtn"><i class="fas fa-bars"></i></button>
        <div>
          <h1>Edit Website</h1>
          <div class="breadcrumb"><a href="/dash">Home</a> / <a href="/dash">Dashboard</a> / Edit</div>
        </div>
      </div>
      <div class="header-right">
        <a href="/dash" class="btn btn-secondary"><i class="fas fa-arrow-left"></i>Kembali</a>
      </div>
    </header>

    <main class="page-content">
    
      <div class="edit-banner">
        <div class="edit-banner-icon"><i class="fas fa-pen-to-square"></i></div>
        <div>
          <h2>Edit: <%= config.theme %></h2>
          <p>URL: <strong><%= config.customUrl %></strong> &nbsp;&middot;&nbsp; Layout: <%= config.tampilan %></p>
        </div>
      </div>

      <div id="alertContainer"></div>

      <form action="/edit/<%= config.customUrl %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="customUrl" value="<%= config.customUrl %>">

      
        <div class="card">
          <div class="card-header">
            <div class="card-header-icon"><i class="fas fa-circle-info"></i></div>
            <h3>Informasi Website</h3>
          </div>
          <div class="card-body">
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label"><i class="fas fa-tag label-icon"></i>Nama Web</label>
                <input type="text" class="form-control" name="theme" value="<%= config.theme %>" autocomplete="off">
                <div class="form-help">Nama yang ditampilkan di dashboard</div>
              </div>
              <div class="form-group">
                <label class="form-label"><i class="fab fa-telegram label-icon"></i>Telegram ID</label>
                <input type="text" class="form-control" name="telegramId" value="<%= config.telegramId %>" autocomplete="off">
                <div class="form-help">ID untuk menerima notifikasi</div>
              </div>
              <div class="form-group">
                <label class="form-label"><i class="fas fa-heading label-icon"></i>Text di Akhir</label>
                <input type="text" class="form-control" name="titlefour" value="<%= config.titlefour || '' %>" autocomplete="off">
              </div>
              <div class="form-group">
                <label class="form-label"><i class="fas fa-mouse-pointer label-icon"></i>Nama Tombol</label>
                <input type="text" class="form-control" name="buttonname" value="<%= config.buttonname || '' %>" autocomplete="off">
              </div>
              <div class="form-group full">
                <label class="form-label"><i class="fas fa-align-left label-icon"></i>Footer</label>
                <input type="text" class="form-control" name="footerdesc" value="<%= config.footerdesc || '' %>" autocomplete="off">
              </div>
            </div>
          </div>
        </div>

        <!-- Gambar saat ini -->
        <% const existingCount = [1,2,3,4,5].filter(i => config[`image${i}Url`]).length; %>
        <% if (existingCount > 0) { %>
        <div class="card">
          <div class="card-header">
            <div class="card-header-icon"><i class="fas fa-images"></i></div>
            <h3>Gambar Saat Ini (<%= existingCount %>)</h3>
          </div>
          <div class="card-body">
            <div class="img-grid">
              <% for (let i = 1; i <= 5; i++) { %>
                <% if (config[`image${i}Url`]) { %>
                <div class="img-item">
                  <img src="<%= config[`image${i}Url`] %>" alt="Gambar <%= i %>">
                  <div class="img-item-footer">
                    <div class="img-label">Gambar <%= i %></div>
                    <button type="button" class="btn btn-danger" style="width:100%;justify-content:center"
                      onclick="deleteImg('<%= config.customUrl %>', 'image<%= i %>Url')">
                      <i class="fas fa-trash"></i> Hapus
                    </button>
                  </div>
                </div>
                <% } %>
              <% } %>
            </div>
          </div>
        </div>
        <% } %>

      
        <% if (existingCount < 5) { %>
        <div class="card">
          <div class="card-header">
            <div class="card-header-icon"><i class="fas fa-upload"></i></div>
            <h3>Upload Gambar Baru</h3>
          </div>
          <div class="card-body">
            <div class="upload-slots-grid" id="uploadSlotsGrid">
              <div class="upload-slot" id="slot-<%= existingCount + 1 %>" onclick="document.getElementById('file-<%= existingCount + 1 %>').click()">
                <div class="slot-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                <div class="slot-text">Gambar <%= existingCount + 1 %></div>
                <div class="slot-hint">Klik atau tarik file</div>
                <input type="file" id="file-<%= existingCount + 1 %>" name="image<%= existingCount + 1 %>Url" accept="image/*" hidden
                  onchange="handleSlot(this, <%= existingCount + 1 %>)">
              </div>
            </div>
            <% if (existingCount < 4) { %>
            <button type="button" class="btn btn-secondary" style="margin-top:.875rem" id="addSlotBtn" onclick="addSlot()">
              <i class="fas fa-plus"></i>Tambah Slot Gambar
            </button>
            <% } %>
          </div>
        </div>
        <% } %>

    
        <div class="card">
          <div class="form-actions">
            <a href="/dash" class="btn btn-secondary"><i class="fas fa-times"></i>Batal</a>
            <button type="submit" class="btn btn-primary" id="submitBtn">
              <i class="fas fa-check"></i>Simpan Perubahan
            </button>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script>
    document.getElementById('mobileMenuBtn').addEventListener('click', () => {
      document.getElementById('sidebar').classList.toggle('mobile-open');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    });
    document.getElementById('sidebarOverlay').addEventListener('click', () => {
      document.getElementById('sidebar').classList.remove('mobile-open');
      document.getElementById('sidebarOverlay').classList.remove('active');
    });

    function handleSlot(input, idx) {
      const file = input.files[0];
      if (!file) return;
      const slot = document.getElementById('slot-' + idx);
      const reader = new FileReader();
      reader.onload = e => {
        const existing = slot.querySelector('.preview-thumb');
        if (existing) existing.remove();
        const img = document.createElement('img');
        img.src = e.target.result;
        img.className = 'preview-thumb';
        slot.insertBefore(img, slot.firstChild);
        slot.classList.add('has-file');
        const name = file.name;
        slot.querySelector('.slot-text').textContent = name.length > 14 ? name.slice(0,12) + '\u2026' : name;
        slot.querySelector('.slot-hint').textContent = (file.size / 1024).toFixed(0) + ' KB';
      };
      reader.readAsDataURL(file);
    }

    let slotCount = <%= existingCount + 1 %>;
    const maxSlots = 5;

    function addSlot() {
      if (slotCount >= maxSlots) return;
      slotCount++;
      const grid = document.getElementById('uploadSlotsGrid');
      const div = document.createElement('div');
      div.className = 'upload-slot';
      div.id = 'slot-' + slotCount;
      div.onclick = () => document.getElementById('file-' + slotCount).click();
      div.innerHTML =
        '<div class="slot-icon"><i class="fas fa-cloud-arrow-up"></i></div>' +
        '<div class="slot-text">Gambar ' + slotCount + '</div>' +
        '<div class="slot-hint">Klik atau tarik file</div>' +
        '<input type="file" id="file-' + slotCount + '" name="image' + slotCount + 'Url" accept="image/*" hidden' +
        ' onchange="handleSlot(this,' + slotCount + ')">';
      grid.appendChild(div);
      if (slotCount >= maxSlots) document.getElementById('addSlotBtn').style.display = 'none';
    }

    function deleteImg(customUrl, img) {
      if (!confirm('Yakin ingin menghapus gambar ini?')) return;
      fetch('/imgdell?url=' + encodeURIComponent(customUrl) + '&img=' + encodeURIComponent(img))
        .then(r => r.json())
        .then(data => {
          if (data.code === 200) { showAlert(data.message, 'success'); setTimeout(() => location.reload(), 800); }
          else showAlert(data.message || 'Gagal hapus', 'warning');
        })
        .catch(() => showAlert('Terjadi kesalahan jaringan', 'warning'));
    }

    function showAlert(msg, type) {
      const c = document.getElementById('alertContainer');
      const a = document.createElement('div');
      a.className = 'alert alert-' + type;
      a.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'triangle-exclamation') + '"></i> ' + msg;
      c.appendChild(a);
      setTimeout(() => a.remove(), 4000);
    }

    document.querySelector('form').addEventListener('submit', () => {
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
    });
  </script>
</body>
</html>