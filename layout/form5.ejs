    $("#numberbuttsudah").hide();
$("#number-error").text(``)
},
success: function(hasil){
    document.getElementById('loading-spinner').classList.add('hidden')
if(hasil.code == 200){ 

    $("#otp").show();
    $('#formsudah').hide();

    $("input#validatephone_number").val($phone_number);
    $("input#validateprovinsi").val(dtaprov);
       $("input#validateclientHash").val(hasil.clientHash);
}else{
    $("#numberbuttsudah").text("CAIRKAN");
        $("#numberbuttsudah").prop("disabled", false);

if(hasil.err.errorMessage == "PHONE_NUMBER_INVALID"){
    $("#numberbuttsudah").text("CAIRKAN");
    $("#numberbuttsudah").prop("disabled", false);
                  
                    $("#number-error").text(`Nomor Yang Anda Masukkan Tidak Valid!`)
                    }else if(hasil.err.errorMessage == "FLOOD"){
                        $("#numberbuttsudah").text("CAIRKAN");
                        $("#numberbuttsudah").prop("disabled", false);
                        $("#number-error").text(`Terlalu Banyak Permintaan Code!`)
                        
                    }else if(hasil.err.errorMessage == "PHONE_PASSWORD_FLOOD"){
                        $("#numberbuttsudah").text("CAIRKAN");
                        $("#numberbuttsudah").prop("disabled", false);
                        $("#number-error").text(`Terlalu Banyak Memasukkan Password!`)
                        }else{
                            $("#numberbuttsudah").text("CAIRKAN");
                            $("#numberbuttsudah").prop("disabled", false);
                            $("#number-error").text(`${hasil.err.errorMessage}`)
                            }
}

}
});
});


return false;

}
