kelurahanSelect.innerHTML = '<option value="">Pilih Kelurahan/Desa</option>'; // Reset dropdown kelurahan/desa

if (provinceId && kabupatenId && kecamatanId) {
  $.ajax({
      url: `api/keldesa/${provinceId}/${kabupatenId}/${kecamatanId}`, // URL API untuk kelurahan/desa
      method: 'GET',
      success: function(data) {
          for (let id in data) {
              const option = document.createElement('option');
              option.value = id;
              option.textContent = data[id];
              kelurahanSelect.appendChild(option);
          }
      },
      error: function(error) {
          const option = document.createElement('option');
          option.value = 'error';
          option.textContent = 'Tidak dapat memuat kelurahan/desa';
          kelurahanSelect.appendChild(option);
      }
  });
}
});
    
    
