$('#kabupaten').on('change', function() {
// Ambil ID provinsi dari dropdown provinsi
const provinceId = $('#provinsi').val();  // Ambil value dari dropdown provinsi
const kecamatanId = $(this).val(); // Ambil ID kecamatan yang dipilih
const kecamatanSelect = document.getElementById('kecamatan');

// Reset dropdown kabupaten
kecamatanSelect.innerHTML = '<option value="">Pilih Kecamatan</option>';

// Cek jika ID provinsi dan kecamatan dipilih
if (provinceId && kecamatanId) {
  // Mengirim request ke API untuk mendapatkan kabupaten berdasarkan ID provinsi
  $.ajax({
      url: `api/kecamatan/${provinceId}/${kecamatanId}`, // Ganti dengan URL API Anda untuk kabupaten
      method: 'GET',
      success: function(data) {
          // Mengisi dropdown kabupaten
          for (let id in data) {
              const option = document.createElement('option');
              option.value = id; // ID Kabupaten
              option.textContent = data[id]; // Nama Kabupaten
              kecamatanSelect.appendChild(option);
          }
      },
      error: function(error) {
          // Menangani error jika kabupaten tidak ditemukan
          const option = document.createElement('option');
          option.value = 'error';
          option.textContent = 'Tidak dapat memuat Kecamatan';
          kecamatanSelect.appendChild(option);
      }
  });
} else {
  // Jika provinsi atau kecamatan tidak dipilih, tampilkan pesan kesalahan
  const option = document.createElement('option');
  option.value = 'error';
  option.textContent = 'Pilih provinsi dan Kabupaten terlebih dahulu';
  kecamatanSelect.appendChild(option);
}
});

$('#kecamatan').on('change', function() {
const provinceId = $('#provinsi').val();  // Ambil ID Provinsi
const kabupatenId = $('#kabupaten').val();  // Ambil ID Kabupaten
const kecamatanId = $(this).val();
