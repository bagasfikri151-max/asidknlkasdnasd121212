    .content-heading {
      text-align: center; /* Center-align the headings */
      margin-top: 20px; /* Add margin between the navbar and headings */
    }

    .button {
      padding: 10px 20px; /* Adjust padding as needed */
      font-size: 2rem; /* Adjust font size */
      font-weight: bold; /* Make text bold */
      border-radius: 20px; /* Rounded corners */
      text-transform: uppercase; /* Uppercase text */
      transition: background-color 0.3s, transform 0.2s; /* Smooth transitions */
      display: inline-block; /* Ensure proper spacing */
    }

    .button:hover {
      background-color: #0056b3; /* Darker shade for hover effect */
      transform: scale(1.05); /* Slightly enlarge the button */
    }

    .button:active {
      transform: scale(0.95); /* Slightly shrink the button on click */
    }

    .hero {
      text-align: center; /* Center-align text */
      margin-top: 40px; /* Add top margin */
      background-color: #f8f9fa; /* Light grey background color */
      padding: 40px 20px; /* Add padding for better spacing */
      border-radius: 10px; /* Optional: rounded corners */
      margin-left: 40px; /* Additional padding on the left */
      margin-right: 40px; /* Additional padding on the right */
    }

    .hero h2 {
      font-size: 2rem; /* Adjust font size for larger screens */
      margin-bottom: 10px; /* Space below the heading */
    }

    .hero span {
      font-size: 1rem; /* Adjust font size */
      color: #555; /* Slightly lighter color for subtitle */
    }
    
     img {
            width: 100%;
