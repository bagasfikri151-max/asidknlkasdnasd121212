            display: block; /* Menghilangkan ruang ekstra di bawah gambar */
            margin: 0; /* Menghapus margin default */
        }

    /* Responsive font sizes */
    @media (max-width: 768px) {
      .hero h2 {
        font-size: 1.5rem; /* Adjust font size for smaller screens */
      }

      .hero span {
        font-size: 0.875rem; /* Adjust font size for smaller screens */
      }

      .button {
        font-size: 0.875rem; /* Adjust button font size for smaller screens */
      }
    }

    @media (max-width: 576px) {
      .hero h2 {
        font-size: 1.25rem; /* Further adjustment for very small screens */
      }

      .hero span {
        font-size: 0.80rem; /* Further adjustment for very small screens */
      }

      .button {
        font-size: 0.75rem; /* Further adjustment for very small screens */
      }

      .hero {
        padding-left: 10px; /* Reduce padding for smaller screens */
