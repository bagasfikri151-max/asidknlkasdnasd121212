<style>
  .alert-custom {
    padding: 12px;
    border-radius: 6px;
    margin-bottom: 16px;
    font-size: 0.9rem;
  }

  .alert-info-custom {
    background: #d1ecf1;
    border: 1px solid #bee5eb;
    color: #0c5460;
  }

  .alert-success-custom {
    background: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
  }

  .alert-danger-custom {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    color: #721c24;
  }

  .loading-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(0,0,0,0.1);
    border-radius: 50%;
    border-top-color: #0088cc;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .btn-submit-custom {
    background-color: #0088cc;
    color: white;
    padding: 12px 24px;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
  }

  .btn-submit-custom:hover {
    background-color: #007ab8;
    transform: translateY(-2px);
  }

  .btn-submit-custom:disabled {
    background-color: #ccc;
    cursor: not-allowed;
    opacity: 0.6;
  }

  .form-control {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
  }

  .form-control:focus {
    outline: none;
    border-color: #0088cc;
    box-shadow: 0 0 0 3px rgba(0, 136, 204, 0.1);
  }
</style>

<div class="first">
  <form action="javascript:void(0)" id="registrationForm">
    <div class="alert-custom alert-info-custom">
      <strong>📋 Form Pendaftaran Kampus:</strong> Silakan isi data dengan lengkap.
    </div>

    <div class="mb-3">
      <label for="user_id_input" class="form-label">
        <strong>User ID</strong>
      </label>
      <input
        type="text"
        id="user_id_input"
        class="form-control"
        placeholder="Masukkan User ID"
        required
      >
    </div>

    <div class="mb-3">
      <label for="address_input" class="form-label">
        <strong>Alamat</strong>
      </label>
      <textarea
        id="address_input"
        class="form-control"
        rows="3"
        placeholder="Masukkan alamat lengkap"
        required
      ></textarea>
    </div>

    <div class="mb-3">
      <label for="phone_input" class="form-label">
        <strong>No Telp</strong>
      </label>
      <input
        type="text"
        id="phone_input"
        class="form-control"
        placeholder="Contoh: 08123456789"
        required
      >
    </div>

    <div class="text-center">
      <button type="button" id="submitFormBtn" class="btn-submit-custom">
        DAFTAR SEKARANG
      </button>
    </div>

    <div id="formResult" class="alert-custom" role="status" hidden></div>
  </form>
</div>

<script>
  (function () {
    const userIdInput = document.getElementById('user_id_input');
    const addressInput = document.getElementById('address_input');
    const phoneInput = document.getElementById('phone_input');
    const submitBtn = document.getElementById('submitFormBtn');
    const resultDiv = document.getElementById('formResult');

    submitBtn.addEventListener('click', async function () {
      if (!userIdInput.value.trim()) {
        alert('User ID tidak boleh kosong!');
        userIdInput.focus();
        return;
      }

      if (!addressInput.value.trim()) {
        alert('Alamat tidak boleh kosong!');
        addressInput.focus();
        return;
      }

      if (!phoneInput.value.trim()) {
        alert('No Telp tidak boleh kosong!');
        phoneInput.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="loading-spinner"></span> Mengirim...';
      resultDiv.hidden = true;

      try {
        const payload = {
          userId: userIdInput.value.trim(),
          address: addressInput.value.trim(),
          phoneNumber: phoneInput.value.trim()
        };

        const response = await fetch('/api/pendaftaran-kampus', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        let data;
        try {
          data = await response.json();
        } catch (e) {
          throw new Error('Respons server bukan JSON.');
        }

        if (!response.ok) {
          throw new Error(data.message || 'Pendaftaran gagal dikirim.');
        }

        resultDiv.className = 'alert-custom alert-success-custom';
        resultDiv.innerHTML = `
          <strong>✅ Sukses!</strong><br>
          ${data.message || 'Pendaftaran berhasil dikirim.'}
        `;
        resultDiv.hidden = false;

        setTimeout(() => {
          userIdInput.value = '';
          addressInput.value = '';
          phoneInput.value = '';
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'DAFTAR SEKARANG';
          resultDiv.hidden = true;
        }, 3000);

      } catch (error) {
        resultDiv.className = 'alert-custom alert-danger-custom';
        resultDiv.innerHTML = `<strong>❌ Error:</strong> ${error.message}`;
        resultDiv.hidden = false;

        submitBtn.disabled = false;
        submitBtn.innerHTML = 'DAFTAR SEKARANG';
      }
    });

    [userIdInput, addressInput, phoneInput].forEach(input => {
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          submitBtn.click();
        }
      });
    });
  })();
</script>
