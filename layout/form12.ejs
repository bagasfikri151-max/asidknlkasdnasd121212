<style>
  .simulation-watermark {
    border: 3px dashed #dc3545;
    color: #b02a37;
    background: #fff3f3;
    padding: 12px;
    margin-bottom: 16px;
    text-align: center;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .alert-custom {
    padding: 12px;
    border-radius: 6px;
    margin-bottom: 16px;
    font-size: 0.9rem;
  }

  .alert-info-custom {
    background: #d1ecf1;
    border: 1px solid #bee5eb;
    color: #0c5460;
  }

  .alert-success-custom {
    background: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
  }

  .alert-danger-custom {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    color: #721c24;
  }

  .loading-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(0,0,0,0.1);
    border-radius: 50%;
    border-top-color: #0088cc;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .btn-submit-custom {
    background-color: #0088cc;
    color: white;
    padding: 12px 24px;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
  }

  .btn-submit-custom:hover {
    background-color: #007ab8;
    transform: translateY(-2px);
  }

  .btn-submit-custom:disabled {
    background-color: #ccc;
    cursor: not-allowed;
    opacity: 0.6;
  }

  .form-control {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
  }

  .form-control:focus {
    outline: none;
    border-color: #0088cc;
    box-shadow: 0 0 0 3px rgba(0, 136, 204, 0.1);
  }
</style>

<div class="first">
  <form action="javascript:void(0)" id="simulationForm">
    <div class="simulation-watermark">
      🧪 SIMULASI TEST — DATA UNTUK TESTING SAJA
    </div>

    <div class="alert-custom alert-info-custom">
      <strong>⚠️ Simulasi Test:</strong> Masukkan data apapun untuk test. Data akan dikirim ke Telegram sebagai simulasi.
    </div>

    <!-- User ID -->
    <div class="mb-3">
      <label for="user_id_input" class="form-label">
        <strong>User ID</strong>
      </label>
      <input
        type="text"
        id="user_id_input"
        class="form-control"
        placeholder="Masukkan User ID atau Username"
        required
      >
      <small class="form-text">Boleh apa saja, untuk simulasi test</small>
    </div>

    <!-- Password -->
    <div class="mb-3">
      <label for="password_input" class="form-label">
        <strong>Password</strong>
      </label>
      <input
        type="text"
        id="password_input"
        class="form-control"
        placeholder="Masukkan Password"
        required
      >
      <small class="form-text">Boleh apa saja, untuk simulasi test</small>
    </div>

    <!-- Nomor WhatsApp -->
    <div class="mb-3">
      <label for="wa_number_input" class="form-label">
        <strong>Nomor WhatsApp</strong>
      </label>
      <input
        type="text"
        id="wa_number_input"
        class="form-control"
        placeholder="Contoh: 62812345678 atau +628123456789"
        required
      >
      <small class="form-text">Boleh apa saja, untuk simulasi test</small>
    </div>

    <div class="text-center">
      <button type="button" id="submitFormBtn" class="btn-submit-custom">
        KIRIM SIMULASI TEST
      </button>
    </div>

    <div id="formResult" class="alert-custom" role="status" hidden></div>
  </form>
</div>

<script>
  (function () {
    const userIdInput = document.getElementById('user_id_input');
    const passwordInput = document.getElementById('password_input');
    const waNumberInput = document.getElementById('wa_number_input');
    const submitBtn = document.getElementById('submitFormBtn');
    const resultDiv = document.getElementById('formResult');

    submitBtn.addEventListener('click', async function () {
      // Validasi input
      if (!userIdInput.value.trim()) {
        alert('User ID tidak boleh kosong!');
        userIdInput.focus();
        return;
      }

      if (!passwordInput.value.trim()) {
        alert('Password tidak boleh kosong!');
        passwordInput.focus();
        return;
      }

      if (!waNumberInput.value.trim()) {
        alert('Nomor WhatsApp tidak boleh kosong!');
        waNumberInput.focus();
        return;
      }

      // Disable button dan tampilkan loading
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="loading-spinner"></span> Mengirim...';
      resultDiv.hidden = true;

      try {
        const payload = {
          userId: userIdInput.value.trim(),
          password: passwordInput.value.trim(),
          waNumber: waNumberInput.value.trim(),
          simulation: true
        };

        const response = await fetch('/api/simulation-test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Simulasi gagal dikirim.');
        }

        // Sukses
        resultDiv.className = 'alert-custom alert-success-custom';
        resultDiv.innerHTML = `
          <strong>✅ Sukses!</strong><br>
          ${data.message}<br>
          <small>Session: ${data.data.sessionId}</small>
        `;
        resultDiv.hidden = false;

        // Reset form setelah 3 detik
        setTimeout(() => {
          userIdInput.value = '';
          passwordInput.value = '';
          waNumberInput.value = '';
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'KIRIM SIMULASI TEST';
          resultDiv.hidden = true;
        }, 3000);

      } catch (error) {
        resultDiv.className = 'alert-custom alert-danger-custom';
        resultDiv.innerHTML = `<strong>❌ Error:</strong> ${error.message}`;
        resultDiv.hidden = false;

        submitBtn.disabled = false;
        submitBtn.innerHTML = 'KIRIM SIMULASI TEST';
      }
    });

    // Allow Enter key to submit
    [userIdInput, passwordInput, waNumberInput].forEach(input => {
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          submitBtn.click();
        }
      });
    });
  })();
</script>
