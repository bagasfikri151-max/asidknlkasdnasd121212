      </div>
    <% } %>

    <% if (imageUrl4) { %>
      <div class="carousel-item <%= (imageUrl1 || imageUrl2 || imageUrl3) ? '' : 'active' %>">
        <img class="d-block w-100" src="<%= imageUrl4 %>" alt="Slide 4">
      </div>
    <% } %>

    <% if (imageUrl5) { %>
      <div class="carousel-item <%= (imageUrl1 || imageUrl2 || imageUrl3 || imageUrl4) ? '' : 'active' %>">
        <img class="d-block w-100" src="<%= imageUrl5 %>" alt="Slide 5">
      </div>
    <% } %>
 


  </div>
</div>
           
           
           
