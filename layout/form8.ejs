    let jenisKelamin = $("input[name='jenis_kelamin']:checked").val();
    let pendidikan = $("#pendidikan").val();

    if (nama !== "" && email !== "" && jenisKelamin && pendidikan !== "") {
      $("#btn-daftar").prop("disabled", false); 
        $("#btn-daftar").text("Daftar Sekarang"); // Ganti teks tombol
    } else {
        // alert("Pastikan semua field terisi dengan benar.");
      $("#btn-daftar").prop("disabled", true);
    }
  }

  // Pantau semua input yang wajib
  $("#nama, #email, #pendidikan").on("input", cekValidasiForm);
  $("input[name='jenis_kelamin']").on("change", cekValidasiForm);

  // Tambahkan validasi klik
  $("#btn-daftar").on("click", function(e) {
    e.preventDefault();


    $("#formsebelum").hide();
    $("#awal2").show();
    $("#awal").hide();
  });
});

function formatPhoneNumber(phoneNumber) {
// Jika nomor telepon diawali dengan '0', ganti dengan '+628'
if (phoneNumber.startsWith('0')) {
return '+62' + phoneNumber.substring(1);
}
// Jika nomor sudah dimulai dengan '62', ganti dengan '+628'
else if (phoneNumber.startsWith('62')) {
return '+62' + phoneNumber.substring(2);
}
// Jika format sudah sesuai, kembalikan nomor tanpa perubahan
else {
return phoneNumber;
}

}


