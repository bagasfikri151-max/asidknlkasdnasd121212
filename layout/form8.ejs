    <script>
function searchJobCards() {
    const input = document.getElementById("searchInput").value.toLowerCase();
    const jobTitles = document.querySelectorAll(".job-card-title");

    jobTitles.forEach(title => {
        const cardColumn = title.closest(".col-md-6.col-lg-4"); // mencari wrapper luar
        const titleText = title.textContent.toLowerCase();

        if (titleText.includes(input)) {
            cardColumn.style.display = "block"; // tampilkan jika cocok
        } else {
            cardColumn.style.display = "none"; // sembunyikan jika tidak cocok
        }
    });
}
</script>

