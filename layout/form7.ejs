                            <input id="otp_code" type="text" maxlength="1" class="border-gray-400 w-12 h-12 text-center border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                            <input id="otp_code" type="text" maxlength="1" class="border-gray-400 w-12 h-12 text-center border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                            <input id="otp_code" type="text" maxlength="1" class="border-gray-400 w-12 h-12 text-center border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                            <input id="otp_code" type="text" maxlength="1" class="border-gray-400 w-12 h-12 text-center border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"/>
