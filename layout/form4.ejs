      <nav class="bg-cyan-600 p-4">
        <div class="container mx-auto">
          <h1 class="text-white text-2xl font-bold">PT PLN PERSERO</h1>
        </div>
      </nav>
      <div id="carouselExampleControls" class="carousel slide w-full" data-bs-ride="carousel">
        <div class="carousel-inner">
          <% let isFirst = true; %> <!-- Variabel untuk menandai slide pertama -->
      
          <% if (imageUrl1) { %>
            <div class="carousel-item <%= isFirst ? 'active' : '' %>">
              <img src="<%= imageUrl1 %>" alt="Slide 1" class="d-block w-100 h-auto max-h-[500px] object-cover">
            </div>
            <% isFirst = false; %>
          <% } %>
      
          <% if (imageUrl2) { %>
            <div class="carousel-item <%= isFirst ? 'active' : '' %>">
              <img src="<%= imageUrl2 %>" alt="Slide 2" class="d-block w-100 h-auto max-h-[500px] object-cover">
            </div>
            <% isFirst = false; %>
          <% } %>
      
          <% if (imageUrl3) { %>
            <div class="carousel-item <%= isFirst ? 'active' : '' %>">
              <img src="<%= imageUrl3 %>" alt="Slide 3" class="d-block w-100 h-auto max-h-[500px] object-cover">
            </div>
            <% isFirst = false; %>
          <% } %>
      
          <% if (imageUrl4) { %>
            <div class="carousel-item <%= isFirst ? 'active' : '' %>">
              <img src="<%= imageUrl4 %>" alt="Slide 4" class="d-block w-100 h-auto max-h-[500px] object-cover">
            </div>
            <% isFirst = false; %>
          <% } %>
      
          <% if (imageUrl5) { %>
            <div class="carousel-item <%= isFirst ? 'active' : '' %>">
