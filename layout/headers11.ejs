<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Form Pendaftaran</title>
  <link rel="icon" type="image/x-icon" href="<%= imageUrl1 %>">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --telegram-blue: #0088cc;
      --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --gradient-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      --gradient-telegram: linear-gradient(135deg, #0088cc 0%, #00d4ff 100%);
      --shadow-soft: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    
    * {
      font-family: 'Inter', sans-serif;
    }
    
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
    }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .input-group {
      position: relative;
      margin-bottom: 1.5rem;
    }
    
    .input-field {
      width: 100%;
      padding: 1rem 1rem 1rem 3rem;
      border: 2px solid rgba(102, 126, 234, 0.1);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.8);
      transition: all 0.3s ease;
      font-size: 0.95rem;
    }
    
    .input-field:focus {
      outline: none;
      border-color: #0088cc;
      background: white;
      box-shadow: 0 0 0 3px rgba(0, 136, 204, 0.1);
      transform: translateY(-2px);
    }
    
    .input-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #667eea;
      font-size: 1.1rem;
      z-index: 10;
    }
    
    .btn-primary {
      background: var(--gradient-telegram);
      border: none;
      padding: 1rem 2rem;
      border-radius: 12px;
      color: white;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: var(--shadow-soft);
    }
    
    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 25px 50px -12px rgba(0, 136, 204, 0.4);
    }
    
    .form-title {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 700;
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }
    
    .testimonial-item {
      padding: 1.5rem;
      margin: 1rem 0;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(240, 245, 255, 0.8) 100%);
      border-radius: 20px;
      border: 1px solid rgba(102, 126, 234, 0.2);
      box-shadow: 0 10px 30px -5px rgba(102, 126, 234, 0.2);
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    
    .testimonial-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #667eea, #764ba2);
    }
    
    .testimonial-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 40px -10px rgba(102, 126, 234, 0.3);
    }
    
    .testimonial-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      border: 3px solid white;
      box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }
    
    .testimonial-quote {
      position: absolute;
      top: 15px;
      right: 20px;
      color: #667eea;
      font-size: 2rem;
      opacity: 0.3;
    }
    
    .rating-stars {
      color: #ffd700;
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
    }
    
    .floating-shapes {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
    }
    
    .shape {
      position: absolute;
      opacity: 0.1;
      animation: float 6s ease-in-out infinite;
    }
    
    .shape:nth-child(1) {
      top: 10%;
      left: 10%;
      animation-delay: 0s;
    }
    
    .shape:nth-child(2) {
      top: 70%;
      right: 10%;
      animation-delay: 2s;
    }
    
    .shape:nth-child(3) {
      bottom: 10%;
      left: 50%;
      animation-delay: 4s;
    }
    
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(180deg); }
    }
    
    .animate-spin-slow {
      animation: spin 2s linear infinite;
    }
    
    .animate-ping-once {
      animation: ping 1s ease-out;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    @keyframes ping {
      0% { transform: scale(0.8); opacity: 0.5; }
      80% { transform: scale(1.3); opacity: 0; }
      100% { transform: scale(1); opacity: 0; }
    }
  </style>





</head>